#!/usr/bin/env bash
# CIX Neo build command.
set -Eeuo pipefail

# shellcheck source=builders/common.sh
source "$(dirname "${BASH_SOURCE[0]}")/builders/common.sh"

list_targets() {
    "${CIX_ROOT}/build-scripts/ci/plan.py" --list-targets --format text
}

usage() {
    cat <<'EOF'
Usage: cix-build TARGET [build|clean]
       cix-build --list

Options:
  --list                 List build targets
  -h, --help             Show this help

Targets:
EOF
    list_targets | while IFS=$'\t' read -r name description; do
        printf '  %-18s %s\n' "${name}" "${description}"
    done
}

case "${1:-}" in
    --list)
        (($# == 1)) || cix_die "--list does not accept arguments"
        list_targets
        exit 0
        ;;
    -h|--help)
        (($# == 1)) || cix_die "$1 does not accept arguments"
        usage
        exit 0
        ;;
    "")
        usage >&2
        exit 2
        ;;
    --*)
        cix_die "unknown option: $1"
        ;;
    *)
        target_name="$1"
        shift
        ;;
esac

action="${1:-build}"
case "${action}" in
    build|clean) ;;
    --*) cix_die "unknown option: ${action}" ;;
    *) cix_die "action must be build or clean: ${action}" ;;
esac
(($# <= 1)) || cix_die "unexpected argument: $2"

cix_require_command nproc python3 realpath
parallel_jobs="$(nproc)"
declare -A TARGET=()
# plan.py emits fixed keys and shell-quotes every YAML value.
eval "$(
    "${CIX_ROOT}/build-scripts/ci/plan.py" \
        --target "${target_name}" \
        --format shell
)"

output_dir="${CIX_ROOT}/output/${target_name}"

cix_validate_host

case "${TARGET[builder]}" in
    kernel)
        # shellcheck source=builders/kernel.sh
        source "${CIX_ROOT}/build-scripts/builders/kernel.sh"
        cix_kernel_build "${action}" "${output_dir}" "${parallel_jobs}"
        ;;
    stable-kernel)
        # shellcheck source=builders/kernel.sh
        source "${CIX_ROOT}/build-scripts/builders/kernel.sh"
        cix_stable_kernel_build "${action}" "${output_dir}" "${parallel_jobs}"
        ;;
    sbuild)
        # shellcheck source=builders/debian.sh
        source "${CIX_ROOT}/build-scripts/builders/debian.sh"
        cix_sbuild_package "${action}" "${output_dir}" "${parallel_jobs}"
        ;;
    firmware)
        # shellcheck source=builders/debian.sh
        source "${CIX_ROOT}/build-scripts/builders/debian.sh"
        # shellcheck source=builders/firmware.sh
        source "${CIX_ROOT}/build-scripts/builders/firmware.sh"
        cix_firmware_package "${action}" "${output_dir}" "${parallel_jobs}"
        ;;
    *)
        cix_die "unsupported build engine: ${TARGET[builder]}"
        ;;
esac
