#!/usr/bin/env bash
# CIX Neo build command.
set -Eeuo pipefail

# shellcheck source=builders/common.sh
source "$(dirname "${BASH_SOURCE[0]}")/builders/common.sh"

list_targets() {
    "${CIX_ROOT}/build-scripts/ci/plan.py" --list-targets --format text
}

list_build_sets() {
    "${CIX_ROOT}/build-scripts/ci/plan.py" --list-build-sets --format text
}

usage() {
    cat <<'EOF'
Usage: cix-build TARGET|BUILD_SET [build|clean] [--backend sbuild|local] [OPTIONS]
       cix-build clean-all
       cix-build distclean
       cix-build --list

Global cleanup commands:
  clean-all              Clean every registered target; preserve caches
  distclean              Clean all targets and clear persistent build caches

Options:
  --backend BACKEND      Debian package backend (default: sbuild)
  --resume               Reuse targets whose inputs and artifacts still match
  --preflight-only       Validate the complete plan without building it
  --list                 List build sets and targets
  -h, --help             Show this help

Build sets:
EOF
    list_build_sets | while IFS=$'\t' read -r name description; do
        printf '  %-18s %s\n' "${name}" "${description}"
    done
    printf '\nTargets:\n'
    list_targets | while IFS=$'\t' read -r name description; do
        printf '  %-18s %s\n' "${name}" "${description}"
    done
}

global_clean_mode=""
case "${1:-}" in
    --list)
        (($# == 1)) || cix_die "--list does not accept arguments"
        list_targets
        exit 0
        ;;
    -h|--help)
        (($# == 1)) || cix_die "$1 does not accept arguments"
        usage
        exit 0
        ;;
    "")
        usage >&2
        exit 2
        ;;
    all)
        cix_die "all is ambiguous; choose all-6.6 or all-7.0"
        ;;
    clean-all|distclean)
        (($# == 1)) || cix_die "$1 does not accept arguments"
        global_clean_mode="$1"
        target_name=""
        ;;
    --*)
        cix_die "unknown option: $1"
        ;;
    *)
        target_name="$1"
        shift
        ;;
esac

debian_backend=sbuild
backend_selected=0
resume_build=0
preflight_only=0
if [[ -n "${global_clean_mode}" ]]; then
    action=clean
else
    action=build
    if [[ "${1:-}" == "build" || "${1:-}" == "clean" ]]; then
        action="$1"
        shift
    fi

    while (($#)); do
        case "$1" in
            --backend)
                (($# >= 2)) || cix_die "--backend requires a value"
                debian_backend="$2"
                backend_selected=1
                shift 2
                ;;
            --backend=*)
                debian_backend="${1#*=}"
                backend_selected=1
                shift
                ;;
            --resume)
                resume_build=1
                shift
                ;;
            --preflight-only)
                preflight_only=1
                shift
                ;;
            --*)
                cix_die "unknown option: $1"
                ;;
            *)
                cix_die "unexpected argument: $1"
                ;;
        esac
    done
fi
case "${debian_backend}" in
    sbuild|local) ;;
    *) cix_die "Debian backend must be sbuild or local: ${debian_backend}" ;;
esac
if [[ "${action}" != build && ("${resume_build}" == 1 || "${preflight_only}" == 1) ]]; then
    cix_die "--resume and --preflight-only apply only to builds"
fi

build_set_name=""
if [[ -z "${global_clean_mode}" ]]; then
    while IFS=$'\t' read -r name _; do
        if [[ "${target_name}" == "${name}" ]]; then
            build_set_name="${name}"
            break
        fi
    done < <(list_build_sets)
fi

cix_require_command nproc python3 realpath
parallel_jobs="$(nproc)"
declare -A TARGET=()
# Consumed by the sourced Debian builder.
# shellcheck disable=SC2034
declare -a TARGET_BUILD_PACKAGES=()
# Optional paths omitted when assembling a repacked quilt source tree.
# shellcheck disable=SC2034
declare -a TARGET_SOURCE_EXCLUDES=()
# Optional additional repositories copied below a quilt source tree.
# shellcheck disable=SC2034
declare -a TARGET_SOURCE_OVERLAYS=()

format_duration() {
    local total_seconds="$1"

    printf '%02d:%02d:%02d' \
        "$((total_seconds / 3600))" \
        "$(((total_seconds % 3600) / 60))" \
        "$((total_seconds % 60))"
}

report_exit() {
    local exit_status="$1"
    local elapsed
    local phase_label
    local -a report_arguments=()

    trap - EXIT
    if ((exit_status != 0)); then
        if [[ -n "${current_target}" ]]; then
            elapsed="$((SECONDS - current_target_started_at))"
            phase_label="${current_phase}"
            [[ "${action}" == clean ]] && phase_label=clean
            cix_log "${current_target} ${phase_label} failed after $(format_duration "${elapsed}")" >&2
        fi
        if [[ -n "${global_clean_mode}" ]]; then
            elapsed="$((SECONDS - command_started_at))"
            cix_log \
                "${global_clean_mode} stopped after" \
                "$(format_duration "${elapsed}")" >&2
        elif [[ -n "${build_set_name}" ]]; then
            elapsed="$((SECONDS - command_started_at))"
            cix_log \
                "${build_set_name} ${action} stopped after" \
                "$(format_duration "${elapsed}")" >&2
        fi
        if [[ -n "${run_report}" ]]; then
            if [[ -n "${current_target}" ]]; then
                report_arguments=(
                    --target "${current_target}"
                    --status failed
                    --phase "${current_phase}"
                    --duration "$((SECONDS - current_target_started_at))"
                )
                if [[ -n "${current_fingerprint}" ]]; then
                    report_arguments+=(--fingerprint "${current_fingerprint}")
                fi
                if [[ -n "${current_target_log}" ]]; then
                    report_arguments+=(--log "${current_target_log}")
                fi
                "${state_tool}" run-update "${run_report}" \
                    "${report_arguments[@]}" || true
            fi
            "${state_tool}" run-finish "${run_report}" --status failed \
                --duration "$((SECONDS - command_started_at))" || true
            cix_log "Build result: ${CIX_ROOT}/${run_report}" >&2
        fi
    fi
    exit "${exit_status}"
}

# shellcheck source=builders/direct.sh
source "${CIX_ROOT}/build-scripts/builders/direct.sh"
# shellcheck source=builders/debian.sh
source "${CIX_ROOT}/build-scripts/builders/debian.sh"
# shellcheck source=builders/preflight.sh
source "${CIX_ROOT}/build-scripts/builders/preflight.sh"
# shellcheck source=commands/cleanup.sh
source "${CIX_ROOT}/build-scripts/commands/cleanup.sh"

load_target() {
    local name="$1"
    local target_definition

    TARGET=()
    TARGET_FILES=()
    TARGET_REQUIRED_FILES=()
    TARGET_SOURCE_EXCLUDES=()
    TARGET_SOURCE_OVERLAYS=()
    TARGET_BUILD_PACKAGES=()
    # plan.py emits fixed keys and shell-quotes every YAML value. Capture its
    # status before eval so a validation error cannot continue with an empty map.
    target_definition="$(
        "${CIX_ROOT}/build-scripts/ci/plan.py" \
            --target "${name}" \
            --format shell
    )"
    eval "${target_definition}"
}

preflight_target() {
    local name="$1"

    current_target="${name}"
    current_phase=preflight
    current_target_started_at="${SECONDS}"
    cix_log "Preflight: ${name}"
    load_target "${name}"
    cix_preflight_target "${debian_backend}"
    if ((preflight_only == 1)); then
        "${state_tool}" run-update "${run_report}" \
            --target "${name}" --status preflight --phase preflight \
            --duration "$((SECONDS - current_target_started_at))"
    fi
    current_target=""
}

execute_loaded_target() {
    local output_dir="$1"

    case "${TARGET[builder]}" in
        direct)
            if ((backend_selected == 1)) && [[ -z "${build_set_name}" ]]; then
                cix_die "--backend applies only to Debian package targets"
            fi
            cix_direct_build "${action}" "${output_dir}" "${parallel_jobs}"
            ;;
        debian)
            cix_debian_build \
                "${action}" "${output_dir}" "${parallel_jobs}" "${debian_backend}"
            ;;
        *) cix_die "unsupported build engine: ${TARGET[builder]}" ;;
    esac
}

run_target() {
    local name="$1"
    local output_dir="${CIX_ROOT}/output/${name}"
    local target_elapsed
    local state_reason

    current_target="${name}"
    current_phase=build
    current_target_started_at="${SECONDS}"
    cix_log "Start ${action}: ${name}"
    load_target "${name}"

    if [[ "${action}" == clean ]]; then
        execute_loaded_target "${output_dir}"
        "${state_tool}" remove "${name}"
        target_elapsed="$((SECONDS - current_target_started_at))"
        cix_log "${name} clean complete in $(format_duration "${target_elapsed}")"
        current_target=""
        return 0
    fi

    current_fingerprint="$(
        "${state_tool}" fingerprint "${name}" --backend "${debian_backend}"
    )"
    current_target_log="${CIX_ROOT}/$(dirname "${run_report}")/logs/${name}.log"
    if ((resume_build == 1)); then
        if state_reason="$(
            "${state_tool}" check "${name}" --fingerprint "${current_fingerprint}"
        )"; then
            cix_log "Resume ${name}: ${state_reason}" | tee "${current_target_log}"
            target_elapsed="$((SECONDS - current_target_started_at))"
            "${state_tool}" run-update "${run_report}" \
                --target "${name}" --status resumed --phase build \
                --duration "${target_elapsed}" \
                --fingerprint "${current_fingerprint}" --log "${current_target_log}"
            cix_log "${name} resumed in $(format_duration "${target_elapsed}")"
            current_target=""
            current_target_log=""
            current_fingerprint=""
            return 0
        fi
        cix_log "Rebuild ${name}: ${state_reason}"
    fi

    execute_loaded_target "${output_dir}" > >(tee "${current_target_log}") 2>&1
    target_elapsed="$((SECONDS - current_target_started_at))"
    "${state_tool}" record "${name}" --backend "${debian_backend}" \
        --fingerprint "${current_fingerprint}" --duration "${target_elapsed}" \
        --log "${current_target_log}" >/dev/null
    "${state_tool}" run-update "${run_report}" \
        --target "${name}" --status built --phase build \
        --duration "${target_elapsed}" --fingerprint "${current_fingerprint}" \
        --log "${current_target_log}"
    cix_log "${name} ${action} complete in $(format_duration "${target_elapsed}")"
    current_target=""
    current_target_log=""
    current_fingerprint=""
}

cix_validate_host
command_started_at="${SECONDS}"
current_target=""
current_target_started_at=0
current_phase=build
current_target_log=""
current_fingerprint=""
run_report=""
state_tool="${CIX_ROOT}/build-scripts/ci/build_state.py"
trap 'report_exit "$?"' EXIT

if [[ -n "${global_clean_mode}" ]]; then
    all_targets_plan="$(
        "${CIX_ROOT}/build-scripts/ci/plan.py" \
            --all-targets \
            --format text \
            --mode order
    )"
    [[ -n "${all_targets_plan}" ]] ||
        cix_die "registered target plan is empty"
    mapfile -t build_set_targets < <(printf '%s\n' "${all_targets_plan}")
    cix_global_cleanup_preflight "${build_set_targets[@]}"
    if [[ "${global_clean_mode}" == distclean ]]; then
        cix_persistent_build_cache_preflight
    fi
    cix_log \
        "Run ${global_clean_mode} for ${#build_set_targets[@]} registered targets"
    for ((index = ${#build_set_targets[@]} - 1; index >= 0; index--)); do
        run_target "${build_set_targets[index]}"
    done
    if [[ "${global_clean_mode}" == distclean ]]; then
        cix_remove_registered_outputs "${build_set_targets[@]}"
        cix_clear_persistent_build_caches
    else
        cix_remove_empty_outputs "${build_set_targets[@]}"
    fi
    cix_log \
        "${global_clean_mode} complete in" \
        "$(format_duration "$((SECONDS - command_started_at))")"
elif [[ -n "${build_set_name}" ]]; then
    build_set_plan="$(
        "${CIX_ROOT}/build-scripts/ci/plan.py" \
            --build-set "${build_set_name}" \
            --format text \
            --mode order
    )"
    [[ -n "${build_set_plan}" ]] || \
        cix_die "${build_set_name} build plan contains no targets"
    mapfile -t build_set_targets < <(printf '%s\n' "${build_set_plan}")
    if [[ "${action}" == build ]]; then
        run_report="$(
            "${state_tool}" run-init --selector "${build_set_name}" \
                --action "$([[ "${preflight_only}" == 1 ]] && printf preflight || printf build)" \
                --backend "${debian_backend}" "${build_set_targets[@]}"
        )"
        cix_log "Build result: ${CIX_ROOT}/${run_report}"
        for name in "${build_set_targets[@]}"; do
            preflight_target "${name}"
        done
        if ((preflight_only == 1)); then
            "${state_tool}" run-finish "${run_report}" --status success \
                --duration "$((SECONDS - command_started_at))"
            cix_log "${build_set_name} preflight complete"
            trap - EXIT
            exit 0
        fi
    fi
    cix_log \
        "Run ${action} for ${build_set_name}: ${#build_set_targets[@]} targets;" \
        "Debian backend: ${debian_backend}"
    if [[ "${action}" == clean ]]; then
        for ((index = ${#build_set_targets[@]} - 1; index >= 0; index--)); do
            run_target "${build_set_targets[index]}"
        done
    else
        for name in "${build_set_targets[@]}"; do
            run_target "${name}"
        done
    fi
    cix_log \
        "${build_set_name} ${action} complete in" \
        "$(format_duration "$((SECONDS - command_started_at))")"
else
    if [[ "${action}" == build ]]; then
        build_set_targets=("${target_name}")
        run_report="$(
            "${state_tool}" run-init --selector "${target_name}" \
                --action "$([[ "${preflight_only}" == 1 ]] && printf preflight || printf build)" \
                --backend "${debian_backend}" "${target_name}"
        )"
        cix_log "Build result: ${CIX_ROOT}/${run_report}"
        preflight_target "${target_name}"
        if ((preflight_only == 1)); then
            "${state_tool}" run-finish "${run_report}" --status success \
                --duration "$((SECONDS - command_started_at))"
            cix_log "${target_name} preflight complete"
            trap - EXIT
            exit 0
        fi
    fi
    run_target "${target_name}"
fi

if [[ -n "${run_report}" ]]; then
    "${state_tool}" run-finish "${run_report}" --status success \
        --duration "$((SECONDS - command_started_at))"
    cix_log "Build result: ${CIX_ROOT}/${run_report}"
fi

trap - EXIT
