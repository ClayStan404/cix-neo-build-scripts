#!/usr/bin/env bash
# CIX Neo build command.
set -Eeuo pipefail

# shellcheck source=builders/common.sh
source "$(dirname "${BASH_SOURCE[0]}")/builders/common.sh"

list_targets() {
    "${CIX_ROOT}/build-scripts/ci/plan.py" --list-targets --format text
}

list_build_sets() {
    "${CIX_ROOT}/build-scripts/ci/plan.py" --list-build-sets --format text
}

usage() {
    cat <<'EOF'
Usage: cix-build TARGET|BUILD_SET [build|clean] [--backend sbuild|local]
       cix-build clean-all
       cix-build distclean
       cix-build --list

Global cleanup commands:
  clean-all              Clean every registered target; preserve caches
  distclean              Clean all targets and clear persistent build caches

Options:
  --backend BACKEND      Debian package backend (default: sbuild)
  --list                 List build sets and targets
  -h, --help             Show this help

Build sets:
EOF
    list_build_sets | while IFS=$'\t' read -r name description; do
        printf '  %-18s %s\n' "${name}" "${description}"
    done
    printf '\nTargets:\n'
    list_targets | while IFS=$'\t' read -r name description; do
        printf '  %-18s %s\n' "${name}" "${description}"
    done
}

global_clean_mode=""
case "${1:-}" in
    --list)
        (($# == 1)) || cix_die "--list does not accept arguments"
        list_targets
        exit 0
        ;;
    -h|--help)
        (($# == 1)) || cix_die "$1 does not accept arguments"
        usage
        exit 0
        ;;
    "")
        usage >&2
        exit 2
        ;;
    all)
        cix_die "all is ambiguous; choose all-6.6 or all-7.0"
        ;;
    clean-all|distclean)
        (($# == 1)) || cix_die "$1 does not accept arguments"
        global_clean_mode="$1"
        target_name=""
        ;;
    --*)
        cix_die "unknown option: $1"
        ;;
    *)
        target_name="$1"
        shift
        ;;
esac

debian_backend=sbuild
backend_selected=0
if [[ -n "${global_clean_mode}" ]]; then
    action=clean
else
    action=build
    if [[ "${1:-}" == "build" || "${1:-}" == "clean" ]]; then
        action="$1"
        shift
    fi

    while (($#)); do
        case "$1" in
            --backend)
                (($# >= 2)) || cix_die "--backend requires a value"
                debian_backend="$2"
                backend_selected=1
                shift 2
                ;;
            --backend=*)
                debian_backend="${1#*=}"
                backend_selected=1
                shift
                ;;
            --*)
                cix_die "unknown option: $1"
                ;;
            *)
                cix_die "unexpected argument: $1"
                ;;
        esac
    done
fi
case "${debian_backend}" in
    sbuild|local) ;;
    *) cix_die "Debian backend must be sbuild or local: ${debian_backend}" ;;
esac

build_set_name=""
if [[ -z "${global_clean_mode}" ]]; then
    while IFS=$'\t' read -r name _; do
        if [[ "${target_name}" == "${name}" ]]; then
            build_set_name="${name}"
            break
        fi
    done < <(list_build_sets)
fi

cix_require_command nproc python3 realpath
parallel_jobs="$(nproc)"
declare -A TARGET=()
# Consumed by the sourced Debian builder.
# shellcheck disable=SC2034
declare -a TARGET_BUILD_PACKAGES=()
# Optional paths omitted when assembling a repacked quilt source tree.
# shellcheck disable=SC2034
declare -a TARGET_SOURCE_EXCLUDES=()
# Optional additional repositories copied below a quilt source tree.
# shellcheck disable=SC2034
declare -a TARGET_SOURCE_OVERLAYS=()

format_duration() {
    local total_seconds="$1"

    printf '%02d:%02d:%02d' \
        "$((total_seconds / 3600))" \
        "$(((total_seconds % 3600) / 60))" \
        "$((total_seconds % 60))"
}

report_exit() {
    local exit_status="$1"
    local elapsed

    trap - EXIT
    if ((exit_status != 0)); then
        if [[ -n "${current_target}" ]]; then
            elapsed="$((SECONDS - current_target_started_at))"
            cix_log "${current_target} ${action} failed after $(format_duration "${elapsed}")" >&2
        fi
        if [[ -n "${global_clean_mode}" ]]; then
            elapsed="$((SECONDS - command_started_at))"
            cix_log \
                "${global_clean_mode} stopped after" \
                "$(format_duration "${elapsed}")" >&2
        elif [[ -n "${build_set_name}" ]]; then
            elapsed="$((SECONDS - command_started_at))"
            cix_log \
                "${build_set_name} ${action} stopped after" \
                "$(format_duration "${elapsed}")" >&2
        fi
    fi
    exit "${exit_status}"
}

# shellcheck source=builders/direct.sh
source "${CIX_ROOT}/build-scripts/builders/direct.sh"
# shellcheck source=builders/debian.sh
source "${CIX_ROOT}/build-scripts/builders/debian.sh"
# shellcheck source=commands/cleanup.sh
source "${CIX_ROOT}/build-scripts/commands/cleanup.sh"

load_target() {
    local name="$1"
    local target_definition

    TARGET=()
    TARGET_FILES=()
    TARGET_REQUIRED_FILES=()
    TARGET_SOURCE_EXCLUDES=()
    TARGET_SOURCE_OVERLAYS=()
    TARGET_BUILD_PACKAGES=()
    # plan.py emits fixed keys and shell-quotes every YAML value. Capture its
    # status before eval so a validation error cannot continue with an empty map.
    target_definition="$(
        "${CIX_ROOT}/build-scripts/ci/plan.py" \
            --target "${name}" \
            --format shell
    )"
    eval "${target_definition}"
}

run_target() {
    local name="$1"
    local output_dir="${CIX_ROOT}/output/${name}"
    local target_elapsed

    current_target="${name}"
    current_target_started_at="${SECONDS}"
    cix_log "Start ${action}: ${name}"
    load_target "${name}"
    case "${TARGET[builder]}" in
        direct)
            if ((backend_selected == 1)) && [[ -z "${build_set_name}" ]]; then
                cix_die "--backend applies only to Debian package targets"
            fi
            cix_direct_build "${action}" "${output_dir}" "${parallel_jobs}"
            ;;
        debian)
            cix_debian_build \
                "${action}" "${output_dir}" "${parallel_jobs}" "${debian_backend}"
            ;;
        *)
            cix_die "unsupported build engine: ${TARGET[builder]}"
            ;;
    esac
    target_elapsed="$((SECONDS - current_target_started_at))"
    cix_log "${name} ${action} complete in $(format_duration "${target_elapsed}")"
    current_target=""
}

cix_validate_host
command_started_at="${SECONDS}"
current_target=""
current_target_started_at=0
trap 'report_exit "$?"' EXIT

if [[ -n "${global_clean_mode}" ]]; then
    all_targets_plan="$(
        "${CIX_ROOT}/build-scripts/ci/plan.py" \
            --all-targets \
            --format text \
            --mode order
    )"
    [[ -n "${all_targets_plan}" ]] ||
        cix_die "registered target plan is empty"
    mapfile -t build_set_targets < <(printf '%s\n' "${all_targets_plan}")
    cix_global_cleanup_preflight "${build_set_targets[@]}"
    if [[ "${global_clean_mode}" == distclean ]]; then
        cix_persistent_build_cache_preflight
    fi
    cix_log \
        "Run ${global_clean_mode} for ${#build_set_targets[@]} registered targets"
    for ((index = ${#build_set_targets[@]} - 1; index >= 0; index--)); do
        run_target "${build_set_targets[index]}"
    done
    if [[ "${global_clean_mode}" == distclean ]]; then
        cix_remove_registered_outputs "${build_set_targets[@]}"
        cix_clear_persistent_build_caches
    else
        cix_remove_empty_registered_outputs "${build_set_targets[@]}"
    fi
    cix_log \
        "${global_clean_mode} complete in" \
        "$(format_duration "$((SECONDS - command_started_at))")"
elif [[ -n "${build_set_name}" ]]; then
    build_set_plan="$(
        "${CIX_ROOT}/build-scripts/ci/plan.py" \
            --build-set "${build_set_name}" \
            --format text \
            --mode order
    )"
    [[ -n "${build_set_plan}" ]] || \
        cix_die "${build_set_name} build plan contains no targets"
    mapfile -t build_set_targets < <(printf '%s\n' "${build_set_plan}")
    cix_log \
        "Run ${action} for ${build_set_name}: ${#build_set_targets[@]} targets;" \
        "Debian backend: ${debian_backend}"
    if [[ "${action}" == clean ]]; then
        for ((index = ${#build_set_targets[@]} - 1; index >= 0; index--)); do
            run_target "${build_set_targets[index]}"
        done
    else
        for name in "${build_set_targets[@]}"; do
            run_target "${name}"
        done
    fi
    cix_log \
        "${build_set_name} ${action} complete in" \
        "$(format_duration "$((SECONDS - command_started_at))")"
else
    run_target "${target_name}"
fi

trap - EXIT
