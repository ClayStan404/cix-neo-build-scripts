#!/usr/bin/env bash
# Install the Debian 13 ARM64 host dependencies used by CIX Neo.
set -Eeuo pipefail

check_only=0
dry_run=0
list_packages=0

usage() {
    cat <<'EOF'
Usage: setup-host [OPTIONS]

Install all host packages required to sync, build, validate, and package the
CIX Neo workspace on native ARM64 Debian 13.

Options:
  --check          Report missing packages without installing them
  --list-packages  Print the canonical package list and exit
  --dry-run        Print mutating commands without running them
  -h, --help       Show this help
EOF
}

die() {
    echo "ERROR: $*" >&2
    exit 1
}

log() {
    echo ">>> $*"
}

run() {
    if ((dry_run)); then
        printf '+'
        printf ' %q' "$@"
        printf '\n'
        return 0
    fi
    "$@"
}

run_as_root() {
    run sudo -- "$@"
}

apt_as_root() {
    local env_args=(DEBIAN_FRONTEND=noninteractive)
    local variable

    for variable in \
        http_proxy https_proxy no_proxy \
        HTTP_PROXY HTTPS_PROXY NO_PROXY; do
        if [[ -n "${!variable:-}" ]]; then
            env_args+=("${variable}=${!variable}")
        fi
    done

    run_as_root env "${env_args[@]}" apt-get "$@"
}

command_is_available() {
    local command_name="$1"

    command -v "${command_name}" >/dev/null 2>&1 ||
        [[ -x "/usr/sbin/${command_name}" || -x "/sbin/${command_name}" ]]
}

verify_debian_build_dependencies() {
    local dependencies
    local missing
    local output
    local workspace
    local -a controls=()

    workspace="$(realpath "$(dirname "${BASH_SOURCE[0]}")/..")"
    shopt -s nullglob
    controls=(
        "${workspace}"/debian/*/control
        "${workspace}"/sources/debian/*/debian/control
    )
    shopt -u nullglob
    ((${#controls[@]} > 0)) || return 0

    dependencies="$(python3 - "${workspace}" <<'PY'
import re
import sys
from pathlib import Path

from debian.deb822 import Deb822, PkgRelation

workspace = Path(sys.argv[1])
controls = list((workspace / "debian").glob("*/control"))
controls += list((workspace / "sources/debian").glob("*/debian/control"))
relations = set()
for control in sorted(controls):
    with control.open(encoding="utf-8") as stream:
        source = next(Deb822.iter_paragraphs(stream))
    for field in ("Build-Depends", "Build-Depends-Arch", "Build-Depends-Indep"):
        value = re.sub(r",\s*$", "", source.get(field, ""))
        if not value:
            continue
        for group in PkgRelation.parse_relations(value):
            names = [alternative["name"] for alternative in group]
            if not any(name.startswith("cix-") for name in names):
                relations.add(PkgRelation.str([group]))
print(", ".join(sorted(relations)))
PY
    )"
    [[ -n "${dependencies}" ]] || return 0
    if ! output="$(
        dpkg-checkbuilddeps -d "${dependencies}" "${controls[0]}" 2>&1
    )"; then
        [[ "${output}" == *"unmet build dependencies: "* ]] ||
            die "cannot check external Debian Build-Depends: ${output}"
        missing="${output#*unmet build dependencies: }"
        die "unmet external Debian Build-Depends: ${missing}"
    fi
    log "All external Debian Build-Depends are installed"
}

