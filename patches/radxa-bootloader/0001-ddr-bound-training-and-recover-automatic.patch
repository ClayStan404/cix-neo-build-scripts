+#define DDR_TRAIN_MAX_ATTEMPTS 3
+#define DDR_FREQUENCY_AUTO     0xFFFF
+
 extern MEMORY_INIT_S* GetMemInitPtr(void);
 
+static
 void
+MemHandleTrainingFailure (
+  void
+  )
+{
+  MEM_CONFIG_BIOS_SETUP *BiosSetup;
+  uint32_t               Size;
+
+  if (FW_OK == CdcbLocateBlockBuf(MEM_CONFIG_BLOCK_BIOS_SETUP_GUID, &Size, (uint8_t**)&BiosSetup) &&
+      BiosSetup->MemFreq != DDR_FREQUENCY_AUTO) {
+    DDR_DRV_FORCE_PRINT(
+      "DDR training failed at explicit %d MT/s; restore Automatic and reset.\n",
+      BiosSetup->MemFreq << 1
+      );
+    BiosSetup->MemFreq = DDR_FREQUENCY_AUTO;
+    if (CdcbUpdateBlockBuf(BiosSetup)) {
+      reset_system();
+    }
+    DDR_DRV_FORCE_PRINT("Failed to persist the Automatic DDR recovery setting.\n");
+  } else {
+    DDR_DRV_FORCE_PRINT("DDR training failed while using the Automatic setting.\n");
+  }
+
+  DDR_DRV_FORCE_PRINT("DDR initialization stopped after %d attempts.\n", DDR_TRAIN_MAX_ATTEMPTS);
+  while (1) {
+  }
+}
