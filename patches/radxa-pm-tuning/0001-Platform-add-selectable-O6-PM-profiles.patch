--- /dev/null
+++ b/Platform/CIX/Sky1/Drivers/PmConfigUpdateDxe/PmConfigUpdateDxe.inf
@@ -0,0 +1,41 @@
+## @file
+#  CIX v3 PM configuration profile updater.
+#
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+##
+
+[Defines]
+  INF_VERSION                    = 0x0001001A
+  BASE_NAME                      = PmConfigUpdateDxe
+  FILE_GUID                      = 8a3c2f7e-d614-4b8a-9e05-6f7d3c1a4b2e
+  MODULE_TYPE                    = DXE_DRIVER
+  VERSION_STRING                 = 1.0
+  ENTRY_POINT                    = PmConfigUpdateDxeEntryPoint
+
+[Sources]
+  PmConfigUpdateDxe.c
+  PmConfigUpdateDxe.h
+
+[Packages]
