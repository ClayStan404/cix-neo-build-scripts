+#string STR_PM_DOMAIN_ENABLE_PROMPT    #language en-US "Override this CPU domain"
+#string STR_PM_DOMAIN_ENABLE_HELP      #language en-US "Used only by Vendor-Capped Custom. Disabled domains keep the PM firmware's native OPN/Vmin table."
