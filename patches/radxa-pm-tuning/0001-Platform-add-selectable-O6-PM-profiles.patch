+/** @file
+  Update the CIX v3 PM configuration from the selected BIOS profile.
+
+  The PM firmware consumes the dedicated 4 KiB PM configuration before UEFI
+  starts. This DXE driver therefore updates that region, verifies the write,
+  and requests a cold reset so the selected profile is consumed on next boot.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "PmConfigUpdateDxe.h"
+
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+
+typedef struct {
+  CONST CHAR8    *Name;
+  UINT8          Domain;
+  UINT8          Size;
+  UINT8          SustainedIndex;
+  UINT8          ProtectedIndex;
+  UINT16         Frequency[PM_CONFIG_OPP_ENTRY_COUNT];
+  UINT16         Voltage[PM_CONFIG_OPP_ENTRY_COUNT];
+  UINT16         MeasuredFrequency[PM_CONFIG_MEASURED_POINT_COUNT];
+  UINT16         MeasuredPower[PM_CONFIG_MEASURED_POINT_COUNT];
+} PM_CPU_DOMAIN_DATA;
+
+STATIC CONST PM_CPU_DOMAIN_DATA  mCpuDomains[PM_CONFIG_CPU_DOMAIN_COUNT] = {
+  {
+    "GB0", 3, 7, 3, PM_CONFIG_CPU_PROTECTED_INDEX,
+    { 800, 1200, 1500, 1800, 2200, 2400, 2500 },
+    { 750, 750, 790, 790, 790, 850, 920 },
+    { 2500, 2400, 2200, 1500, 1200, 800, 100 },
+    { 5000, 4500, 3500, 2000, 1600, 500, 50 }
+  },
+  {
+    "GB1", 4, 7, 3, PM_CONFIG_CPU_PROTECTED_INDEX,
+    { 800, 1200, 1500, 1800, 2200, 2500, 2600 },
+    { 750, 750, 790, 790, 790, 850, 920 },
+    { 2600, 2500, 2200, 1500, 1200, 800, 100 },
+    { 5100, 4700, 3600, 2000, 1600, 500, 50 }
+  },
+  {
+    "GM0", 5, 7, 3, PM_CONFIG_CPU_PROTECTED_INDEX,
+    { 800, 1200, 1500, 1800, 2100, 2200, 2300 },
+    { 750, 750, 790, 790, 790, 850, 890 },
+    { 2300, 2200, 2100, 1500, 1200, 800, 100 },
+    { 3500, 3200, 3000, 1900, 1500, 500, 50 }
+  },
+  {
+    "GM1", 6, 6, 3, PM_CONFIG_CPU_PROTECTED_INDEX,
+    { 800, 1200, 1500, 1800, 2100, 2200 },
+    { 750, 750, 790, 790, 850, 890 },
+    { 2200, 2100, 1800, 1500, 1200, 800, 100 },
+    { 3500, 3300, 2800, 1900, 1500, 500, 50 }
+  }
+};
+
+STATIC CONST UINT8  mSourceDomainSize[PM_CONFIG_OPP_CONFIGURED_DOMAINS] = {
+  6, 6, 2, 7, 7, 7, 6, 2, 4, 6, 2, 3
+};
+
+STATIC CONST UINT8  mSourceSustainedIndex[PM_CONFIG_OPP_CONFIGURED_DOMAINS] = {
+  5, 5, 1, 3, 3, 3, 3, 1, 2, 5, 1, 2
+};
+
+STATIC
+UINT16
+PmRead16 (
+  IN CONST UINT8  *Buffer,
+  IN UINTN        Offset
+  )
+{
+  UINT16  Value;
+
+  CopyMem (&Value, Buffer + Offset, sizeof (Value));
+  return Value;
+}
+
+STATIC
+UINT32
+PmRead32 (
+  IN CONST UINT8  *Buffer,
+  IN UINTN        Offset
+  )
+{
+  UINT32  Value;
+
+  CopyMem (&Value, Buffer + Offset, sizeof (Value));
+  return Value;
+}
+
+STATIC
+VOID
+PmWrite16 (
+  IN OUT UINT8  *Buffer,
+  IN UINTN      Offset,
+  IN UINT16     Value
+  )
+{
+  CopyMem (Buffer + Offset, &Value, sizeof (Value));
+}
+
+STATIC
+VOID
+PmWrite32 (
+  IN OUT UINT8  *Buffer,
+  IN UINTN      Offset,
+  IN UINT32     Value
+  )
+{
+  CopyMem (Buffer + Offset, &Value, sizeof (Value));
+}
+
+STATIC
+UINTN
+PmSettingsIndex (
+  IN UINTN  CpuDomain,
+  IN UINTN  Opp
+  )
+{
+  return (CpuDomain * RADXA_PM_OPP_COUNT) + Opp;
+}
+
+STATIC
+UINT32
+PmMeasuredPower (
+  IN CONST PM_CPU_DOMAIN_DATA  *Domain,
+  IN UINT16                    Frequency
+  )
+{
+  UINT32  FrequencyDelta;
+  UINT32  Index;
+  UINT32  LowerFrequency;
+  UINT32  LowerPower;
+  UINT32  PowerDelta;
+
+  for (Index = 0; Index < PM_CONFIG_MEASURED_POINT_COUNT; Index++) {
+    if (Domain->MeasuredFrequency[Index] == Frequency) {
+      return Domain->MeasuredPower[Index];
+    }
+
+    if (Domain->MeasuredFrequency[Index] < Frequency) {
+      break;
+    }
+  }
+
+  if (Index == PM_CONFIG_MEASURED_POINT_COUNT) {
+    Index--;
+  } else if (Index == 0) {
+    Index++;
+  }
+
+  LowerFrequency = Domain->MeasuredFrequency[Index];
+  LowerPower     = Domain->MeasuredPower[Index];
+  FrequencyDelta = Domain->MeasuredFrequency[Index - 1] - LowerFrequency;
+  PowerDelta     = Domain->MeasuredPower[Index - 1] - LowerPower;
+
+  return LowerPower +
+         (PowerDelta * (Frequency - LowerFrequency)) / FrequencyDelta;
+}
+
+STATIC
+UINT16
+PmReferenceVoltage (
+  IN CONST PM_CPU_DOMAIN_DATA  *Domain,
+  IN UINT16                    Frequency
+  )
+{
+  UINT32  FrequencyDelta;
+  UINT32  Index;
+  UINT32  LowerFrequency;
+  UINT32  LowerVoltage;
+  UINT32  VoltageDelta;
+
+  if (Frequency <= Domain->Frequency[0]) {
+    return Domain->Voltage[0];
+  }
+
+  for (Index = 1; Index < Domain->Size; Index++) {
+    if (Frequency <= Domain->Frequency[Index]) {
+      LowerFrequency = Domain->Frequency[Index - 1];
+      LowerVoltage   = Domain->Voltage[Index - 1];
+      FrequencyDelta = Domain->Frequency[Index] - LowerFrequency;
+      VoltageDelta   = Domain->Voltage[Index] - LowerVoltage;
+      return (UINT16)(LowerVoltage +
+                      (VoltageDelta * (Frequency - LowerFrequency)) /
+                      FrequencyDelta);
+    }
+  }
+
+  return Domain->Voltage[Domain->Size - 1];
+}
+
+STATIC
+UINT32
+PmConservativePower (
+  IN CONST PM_CPU_DOMAIN_DATA  *Domain,
+  IN UINT16                    Frequency,
+  IN UINT16                    Voltage,
+  IN UINT8                     VoltageMode
+  )
+{
+  UINT64  Denominator;
+  UINT64  Estimate;
+  UINT64  Numerator;
+  UINT64  Remainder;
+  UINT32  BasePower;
+  UINT32  PowerVoltage;
+  UINT32  ReferenceVoltage;
+
+  BasePower       = PmMeasuredPower (Domain, Frequency);
+  ReferenceVoltage = PmReferenceVoltage (Domain, Frequency);
+  PowerVoltage    = Voltage;
+  if ((VoltageMode != RADXA_PM_VOLTAGE_FIXED) &&
+      (PowerVoltage < PM_CONFIG_VMIN_VOLTAGE_CEILING))
+  {
+    PowerVoltage = PM_CONFIG_VMIN_VOLTAGE_CEILING;
+  }
+
+  if (PowerVoltage <= ReferenceVoltage) {
+    return BasePower;
+  }
+
+  Numerator = MultU64x32 (
+                MultU64x32 ((UINT64)BasePower, PowerVoltage),
+                PowerVoltage
+                );
+  Denominator = MultU64x32 (
+                  (UINT64)ReferenceVoltage,
+                  ReferenceVoltage
+                  );
+  Estimate = DivU64x64Remainder (Numerator, Denominator, &Remainder);
+  if (Remainder != 0) {
+    Estimate++;
+  }
+
+  return (UINT32)Estimate;
+}
+
+STATIC
+UINT16
+PmEncodeVoltage (
+  IN UINT16  Voltage,
+  IN UINT8   Mode
+  )
+{
+  return Voltage + Mode;
+}
+
+STATIC
+UINT16
+PmVoltageBase (
+  IN UINT32  EncodedVoltage
+  )
+{
+  return (UINT16)(EncodedVoltage - (EncodedVoltage % 5U));
+}
+
+STATIC
+VOID
+PmCalculateChecksum (
+  IN CONST UINT8  *Buffer,
+  IN UINT32       Length,
+  OUT UINT32      *Crc1,
+  OUT UINT32      *Crc2
+  )
+{
+  UINT32  Cka;
+  UINT32  Ckb;
+  UINT32  Offset;
+  UINT32  Word;
+
+  Cka = 0;
+  Ckb = 0;
+  for (Offset = 0; Offset < Length; Offset += sizeof (UINT32)) {
+    if ((Offset == PM_CONFIG_CRC1_OFFSET) ||
+        (Offset == PM_CONFIG_CRC2_OFFSET))
+    {
+      Word = 0;
+    } else {
+      Word = PmRead32 (Buffer, Offset);
+    }
+
+    Cka += Word;
+    Ckb += Cka;
+  }
+
+  *Crc1 = Cka;
+  *Crc2 = Ckb;
+}
+
+STATIC
+VOID
+PmInitializeSettings (
+  OUT RADXA_PM_TUNING_DATA  *Settings
+  )
+{
+  UINTN  CpuDomain;
+  UINTN  Opp;
+  UINTN  Index;
+
+  ZeroMem (Settings, sizeof (*Settings));
+  Settings->Profile   = RADXA_PM_PROFILE_VENDOR;
+  Settings->Revision  = RADXA_PM_TUNING_REVISION;
+  Settings->DataSize  = sizeof (*Settings);
+  Settings->Signature = RADXA_PM_TUNING_SIGNATURE;
+  for (CpuDomain = 0; CpuDomain < ARRAY_SIZE (mCpuDomains); CpuDomain++) {
+    for (Opp = 0; Opp < mCpuDomains[CpuDomain].Size; Opp++) {
+      Index = PmSettingsIndex (CpuDomain, Opp);
+      Settings->CpuFrequency[Index] = mCpuDomains[CpuDomain].Frequency[Opp];
+      Settings->CpuVoltage[Index]   = mCpuDomains[CpuDomain].Voltage[Opp];
+    }
+  }
+}
+
+STATIC
+BOOLEAN
+PmCustomSettingsAreValid (
+  IN CONST RADXA_PM_TUNING_DATA  *Settings
+  )
+{
+  CONST PM_CPU_DOMAIN_DATA  *Domain;
+  UINT16                    Frequency;
+  UINT16                    PreviousFrequency;
+  UINT16                    PreviousVoltage;
+  UINT16                    Voltage;
+  UINT8                     VoltageMode;
+  UINTN                     EnabledDomains;
+  UINTN                     CpuDomain;
+  UINTN                     Index;
+  UINTN                     Opp;
+
+  EnabledDomains = 0;
+  for (CpuDomain = 0; CpuDomain < ARRAY_SIZE (mCpuDomains); CpuDomain++) {
+    Domain           = &mCpuDomains[CpuDomain];
+    if (Settings->CpuDomainEnabled[CpuDomain] > 1) {
+      DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Invalid %a partial-domain state\n", Domain->Name));
+      return FALSE;
+    }
+
+    EnabledDomains += Settings->CpuDomainEnabled[CpuDomain];
+
+    PreviousFrequency = 0;
+    PreviousVoltage   = 0;
+    for (Opp = 0; Opp < Domain->Size; Opp++) {
+      Index       = PmSettingsIndex (CpuDomain, Opp);
+      Frequency   = Settings->CpuFrequency[Index];
+      Voltage     = Settings->CpuVoltage[Index];
+      VoltageMode = Settings->CpuVoltageMode[Index];
+
+      if ((Frequency < PM_CONFIG_CPU_FREQUENCY_MIN) ||
+          (Frequency > PM_CONFIG_CPU_FREQUENCY_MAX) ||
+          ((Frequency % 10U) != 0) ||
+          (Voltage < PM_CONFIG_CPU_VOLTAGE_MIN) ||
+          (Voltage > PM_CONFIG_CPU_VOLTAGE_MAX) ||
+          ((Voltage % 10U) != 0) ||
+          (VoltageMode > RADXA_PM_VOLTAGE_MODE_MAX))
+      {
+        DEBUG ((
+          DEBUG_ERROR,
+          "[PmConfigUpdate] %a OPP %u is outside the custom limits\n",
+          Domain->Name,
+          (UINT32)Opp
+          ));
+        return FALSE;
+      }
+
+      if ((Opp > 0) &&
+          ((Frequency <= PreviousFrequency) || (Voltage < PreviousVoltage)))
+      {
+        DEBUG ((
+          DEBUG_ERROR,
+          "[PmConfigUpdate] %a OPP table is not monotonic at index %u\n",
+          Domain->Name,
+          (UINT32)Opp
+          ));
+        return FALSE;
+      }
+
+      if ((Opp == Domain->ProtectedIndex) &&
+          ((Frequency != PM_CONFIG_CPU_BOOT_LEVEL) ||
+           (Voltage != PM_CONFIG_CPU_BOOT_VOLTAGE) ||
+           (VoltageMode != RADXA_PM_VOLTAGE_FIXED)))
+      {
+        DEBUG ((
+          DEBUG_ERROR,
+          "[PmConfigUpdate] %a boot OPP is not editable\n",
+          Domain->Name
+          ));
+        return FALSE;
+      }
+
+      PreviousFrequency = Frequency;
+      PreviousVoltage   = Voltage;
+    }
+  }
+
+  if ((Settings->Profile == RADXA_PM_PROFILE_PARTIAL) &&
+      (EnabledDomains == 0))
+  {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Partial profile has no enabled CPU domain\n"));
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+STATIC
+BOOLEAN
+PmSettingsAreValid (
+  IN CONST RADXA_PM_TUNING_DATA  *Settings
+  )
+{
+  if ((Settings->Revision != RADXA_PM_TUNING_REVISION) ||
+      (Settings->DataSize != sizeof (*Settings)) ||
+      (Settings->Signature != RADXA_PM_TUNING_SIGNATURE))
+  {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Invalid PM tuning variable header\n"));
+    return FALSE;
+  }
+
+  if (Settings->Profile > RADXA_PM_PROFILE_MAX) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Unknown PM profile\n"));
+    return FALSE;
+  }
+
+#if (PM_ENGINEERING_SUPPORT == 0)
+  if ((Settings->Profile == RADXA_PM_PROFILE_GB1_2700) ||
+      (Settings->Profile == RADXA_PM_PROFILE_CUSTOM))
+  {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Engineering profile is disabled\n"));
+    return FALSE;
+  }
+#endif
+
+  return (((Settings->Profile != RADXA_PM_PROFILE_CUSTOM) &&
+           (Settings->Profile != RADXA_PM_PROFILE_PARTIAL)) ||
+          PmCustomSettingsAreValid (Settings));
+}
+
+STATIC
+BOOLEAN
+PmDsuIsStock (
+  IN CONST UINT8  *Buffer
+  )
+{
+  UINTN  EntryOffset;
+  UINTN  Opp;
+
+  if ((PmRead16 (Buffer, PM_CONFIG_OPP_DOMAIN_OFFSET (PM_CONFIG_DSU_DOMAIN_INDEX)) != 2) ||
+      (PmRead16 (
+         Buffer,
+         PM_CONFIG_OPP_DOMAIN_OFFSET (PM_CONFIG_DSU_DOMAIN_INDEX) + sizeof (UINT16)
+         ) != 1))
+  {
+    return FALSE;
+  }
+
+  for (Opp = 0; Opp < PM_CONFIG_OPP_ENTRY_COUNT; Opp++) {
+    EntryOffset = PM_CONFIG_OPP_ENTRY_OFFSET (PM_CONFIG_DSU_DOMAIN_INDEX, Opp);
+    if (Opp == 0) {
+      if ((PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_LEVEL_OFFSET) != 500) ||
+          (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_VOLTAGE_OFFSET) != 790) ||
+          (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_FREQUENCY_OFFSET) != 0) ||
+          (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_POWER_OFFSET) != 0))
+      {
+        return FALSE;
+      }
+    } else if (Opp == 1) {
+      if ((PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_LEVEL_OFFSET) != 1300) ||
+          (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_VOLTAGE_OFFSET) != 790) ||
+          (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_FREQUENCY_OFFSET) != 0) ||
+          (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_POWER_OFFSET) != 0))
+      {
+        return FALSE;
+      }
+    } else if ((PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_LEVEL_OFFSET) != 0) ||
+               (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_VOLTAGE_OFFSET) != 0) ||
+               (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_FREQUENCY_OFFSET) != 0) ||
+               (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_POWER_OFFSET) != 0))
+    {
+      return FALSE;
+    }
+  }
+
+  return TRUE;
+}
+
+STATIC
+BOOLEAN
+PmCpuTablesAreValid (
+  IN CONST UINT8  *Buffer,
+  IN BOOLEAN      AllowDisabled
+  )
+{
+  CONST PM_CPU_DOMAIN_DATA  *Domain;
+  UINT32                    EntryOffset;
+  UINT32                    Frequency;
+  UINT32                    Power;
+  UINT32                    PreviousFrequency;
+  UINT32                    PreviousVoltage;
+  UINT32                    Voltage;
+  UINT32                    VoltageBase;
+  UINT32                    VoltageMode;
+  UINTN                     CpuDomain;
+  UINTN                     Opp;
+
+  for (CpuDomain = 0; CpuDomain < ARRAY_SIZE (mCpuDomains); CpuDomain++) {
+    Domain = &mCpuDomains[CpuDomain];
+    if (PmRead16 (Buffer, PM_CONFIG_OPP_DOMAIN_OFFSET (Domain->Domain)) ==
+        PM_CONFIG_OPP_DOMAIN_DISABLED)
+    {
+      if (AllowDisabled &&
+          (PmRead16 (
+             Buffer,
+             PM_CONFIG_OPP_DOMAIN_OFFSET (Domain->Domain) + sizeof (UINT16)
+             ) == PM_CONFIG_OPP_DOMAIN_DISABLED))
+      {
+        continue;
+      }
+
+      DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Invalid disabled %a OPP header\n", Domain->Name));
+      return FALSE;
+    }
+
+    if ((PmRead16 (Buffer, PM_CONFIG_OPP_DOMAIN_OFFSET (Domain->Domain)) != Domain->Size) ||
+        (PmRead16 (
+           Buffer,
+           PM_CONFIG_OPP_DOMAIN_OFFSET (Domain->Domain) + sizeof (UINT16)
+           ) != Domain->SustainedIndex))
+    {
+      DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Unsupported %a OPP header\n", Domain->Name));
+      return FALSE;
+    }
+
+    PreviousFrequency = 0;
+    PreviousVoltage   = 0;
+    for (Opp = 0; Opp < PM_CONFIG_OPP_ENTRY_COUNT; Opp++) {
+      EntryOffset = PM_CONFIG_OPP_ENTRY_OFFSET (Domain->Domain, Opp);
+      Frequency   = PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_LEVEL_OFFSET);
+      Power       = PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_POWER_OFFSET);
+      Voltage     = PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_VOLTAGE_OFFSET);
+      VoltageBase = PmVoltageBase (Voltage);
+      VoltageMode = Voltage % 5U;
+
+      if (Opp >= Domain->Size) {
+        if ((Frequency != 0) || (Voltage != 0) ||
+            (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_FREQUENCY_OFFSET) != 0) ||
+            (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_POWER_OFFSET) != 0))
+        {
+          DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] %a has a hidden OPP\n", Domain->Name));
+          return FALSE;
+        }
+
+        continue;
+      }
+
+      if ((Frequency < PM_CONFIG_CPU_FREQUENCY_MIN) ||
+          (Frequency > PM_CONFIG_CPU_FREQUENCY_MAX) ||
+          ((Frequency % 10U) != 0) ||
+          (VoltageBase < PM_CONFIG_CPU_VOLTAGE_MIN) ||
+          (VoltageBase > PM_CONFIG_CPU_VOLTAGE_MAX) ||
+          ((VoltageBase % 10U) != 0) ||
+          (VoltageMode > RADXA_PM_VOLTAGE_MODE_MAX) ||
+          (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_FREQUENCY_OFFSET) != 0) ||
+          (Power == 0) ||
+          (Power > PM_CONFIG_CPU_POWER_MAX))
+      {
+        DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Invalid %a OPP %u\n", Domain->Name, (UINT32)Opp));
+        return FALSE;
+      }
+
+      if ((Opp > 0) &&
+          ((Frequency <= PreviousFrequency) || (VoltageBase < PreviousVoltage)))
+      {
+        DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] %a table is not monotonic\n", Domain->Name));
+        return FALSE;
+      }
+
+      PreviousFrequency = Frequency;
+      PreviousVoltage   = VoltageBase;
+    }
+  }
+
+  return TRUE;
+}
+
+STATIC
+BOOLEAN
+PmPartialTablesAreValid (
+  IN CONST UINT8  *Buffer
+  )
+{
+  UINT16  Size;
+  UINT16  SustainedIndex;
+  UINTN   Domain;
+
+  for (Domain = 0; Domain < PM_CONFIG_OPP_DOMAIN_COUNT; Domain++) {
+    if ((Domain >= PM_CONFIG_CPU_DOMAIN_FIRST) &&
+        (Domain <= PM_CONFIG_CPU_DOMAIN_LAST))
+    {
+      continue;
+    }
+
+    Size = PmRead16 (Buffer, PM_CONFIG_OPP_DOMAIN_OFFSET (Domain));
+    SustainedIndex = PmRead16 (
+                       Buffer,
+                       PM_CONFIG_OPP_DOMAIN_OFFSET (Domain) + sizeof (UINT16)
+                       );
+    if ((Size != PM_CONFIG_OPP_DOMAIN_DISABLED) ||
+        (SustainedIndex != PM_CONFIG_OPP_DOMAIN_DISABLED))
+    {
+      DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Partial profile overrides domain %u\n", (UINT32)Domain));
+      return FALSE;
+    }
+  }
+
+  return PmCpuTablesAreValid (Buffer, TRUE);
+}
+
+STATIC
+BOOLEAN
+PmValidateConfig (
+  IN CONST UINT8  *Buffer
+  )
+{
+  UINT32  ExpectedCrc1;
+  UINT32  ExpectedCrc2;
+  UINT32  Length;
+
+  if ((PmRead16 (Buffer, PM_CONFIG_VERSION_MAJOR_OFFSET) !=
+       PM_CONFIG_SCHEMA_MAJOR) ||
+      (PmRead16 (Buffer, PM_CONFIG_VERSION_MINOR_OFFSET) !=
+       PM_CONFIG_SCHEMA_MINOR) ||
+      (PmRead32 (Buffer, PM_CONFIG_SIGNATURE_OFFSET) != PM_CONFIG_SIGNATURE))
+  {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Unsupported PM config header\n"));
+    return FALSE;
+  }
+
+  Length = PmRead32 (Buffer, PM_CONFIG_LENGTH_OFFSET);
+  if ((Length < PM_CONFIG_DSU_END) ||
+      (Length > PM_CONFIG_BIN_SIZE) ||
+      ((Length & (sizeof (UINT32) - 1)) != 0))
+  {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Invalid PM config length: %u\n", Length));
+    return FALSE;
+  }
+
+  PmCalculateChecksum (Buffer, Length, &ExpectedCrc1, &ExpectedCrc2);
+  if ((PmRead32 (Buffer, PM_CONFIG_CRC1_OFFSET) != ExpectedCrc1) ||
+      (PmRead32 (Buffer, PM_CONFIG_CRC2_OFFSET) != ExpectedCrc2))
+  {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] PM config checksum mismatch\n"));
+    return FALSE;
+  }
+
+  switch (Buffer[PM_CONFIG_OPP_VALID_OFFSET]) {
+    case PM_CONFIG_OPP_EXTERNAL_INVALID:
+      break;
+    case PM_CONFIG_OPP_EXTERNAL_VALID:
+      if (!PmCpuTablesAreValid (Buffer, FALSE) || !PmDsuIsStock (Buffer)) {
+        DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Invalid complete external OPP table\n"));
+        return FALSE;
+      }
+
+      break;
+    case PM_CONFIG_OPP_EXTERNAL_PARTIAL:
+      if (!PmPartialTablesAreValid (Buffer)) {
+        DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Invalid partial external OPP table\n"));
+        return FALSE;
+      }
+
+      break;
+    default:
+      DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Unsupported external OPP state: 0x%x\n", Buffer[PM_CONFIG_OPP_VALID_OFFSET]));
+      return FALSE;
+  }
+
+  return TRUE;
+}
+
+STATIC
+VOID
+PmSetFullTableHeaders (
+  IN OUT UINT8  *Buffer
+  )
+{
+  UINTN  Domain;
+
+  for (Domain = 0; Domain < PM_CONFIG_OPP_CONFIGURED_DOMAINS; Domain++) {
+    PmWrite16 (
+      Buffer,
+      PM_CONFIG_OPP_DOMAIN_OFFSET (Domain),
+      mSourceDomainSize[Domain]
+      );
+    PmWrite16 (
+      Buffer,
+      PM_CONFIG_OPP_DOMAIN_OFFSET (Domain) + sizeof (UINT16),
+      mSourceSustainedIndex[Domain]
+      );
+  }
+
+  PmWrite16 (
+    Buffer,
+    PM_CONFIG_OPP_DOMAIN_OFFSET (PM_CONFIG_OPP_CONFIGURED_DOMAINS),
+    PM_CONFIG_OPP_DOMAIN_DISABLED
+    );
+  PmWrite16 (
+    Buffer,
+    PM_CONFIG_OPP_DOMAIN_OFFSET (PM_CONFIG_OPP_CONFIGURED_DOMAINS) + sizeof (UINT16),
+    PM_CONFIG_OPP_DOMAIN_DISABLED
+    );
+}
+
+STATIC
+VOID
+PmSetPartialTableHeaders (
+  IN OUT UINT8                    *Buffer,
+  IN CONST RADXA_PM_TUNING_DATA   *Settings
+  )
+{
+  CONST PM_CPU_DOMAIN_DATA  *Cpu;
+  UINTN                     CpuDomain;
+  UINTN                     Domain;
+
+  for (Domain = 0; Domain < PM_CONFIG_OPP_DOMAIN_COUNT; Domain++) {
+    PmWrite16 (
+      Buffer,
+      PM_CONFIG_OPP_DOMAIN_OFFSET (Domain),
+      PM_CONFIG_OPP_DOMAIN_DISABLED
+      );
+    PmWrite16 (
+      Buffer,
+      PM_CONFIG_OPP_DOMAIN_OFFSET (Domain) + sizeof (UINT16),
+      PM_CONFIG_OPP_DOMAIN_DISABLED
+      );
+  }
+
+  for (CpuDomain = 0; CpuDomain < ARRAY_SIZE (mCpuDomains); CpuDomain++) {
+    if (Settings->CpuDomainEnabled[CpuDomain] == 0) {
+      continue;
+    }
+
+    Cpu = &mCpuDomains[CpuDomain];
+    PmWrite16 (Buffer, PM_CONFIG_OPP_DOMAIN_OFFSET (Cpu->Domain), Cpu->Size);
+    PmWrite16 (
+      Buffer,
+      PM_CONFIG_OPP_DOMAIN_OFFSET (Cpu->Domain) + sizeof (UINT16),
+      Cpu->SustainedIndex
+      );
+  }
+}
+
+STATIC
+BOOLEAN
+PmFullTableHeadersMatch (
+  IN CONST UINT8  *Buffer
+  )
+{
+  UINTN  Domain;
+
+  for (Domain = 0; Domain < PM_CONFIG_OPP_CONFIGURED_DOMAINS; Domain++) {
+    if ((PmRead16 (Buffer, PM_CONFIG_OPP_DOMAIN_OFFSET (Domain)) !=
+         mSourceDomainSize[Domain]) ||
+        (PmRead16 (
+           Buffer,
+           PM_CONFIG_OPP_DOMAIN_OFFSET (Domain) + sizeof (UINT16)
+           ) != mSourceSustainedIndex[Domain]))
+    {
+      return FALSE;
+    }
+  }
+
+  return (PmRead16 (
+            Buffer,
+            PM_CONFIG_OPP_DOMAIN_OFFSET (PM_CONFIG_OPP_CONFIGURED_DOMAINS)
+            ) == PM_CONFIG_OPP_DOMAIN_DISABLED) &&
+         (PmRead16 (
+            Buffer,
+            PM_CONFIG_OPP_DOMAIN_OFFSET (PM_CONFIG_OPP_CONFIGURED_DOMAINS) + sizeof (UINT16)
+            ) == PM_CONFIG_OPP_DOMAIN_DISABLED);
+}
+
+STATIC
+BOOLEAN
+PmPartialTableHeadersMatch (
+  IN CONST UINT8                 *Buffer,
+  IN CONST RADXA_PM_TUNING_DATA  *Settings
+  )
+{
+  CONST PM_CPU_DOMAIN_DATA  *Cpu;
+  UINT16                    ExpectedSize;
+  UINT16                    ExpectedSustained;
+  UINTN                     CpuDomain;
+  UINTN                     Domain;
+
+  for (Domain = 0; Domain < PM_CONFIG_OPP_DOMAIN_COUNT; Domain++) {
+    ExpectedSize      = PM_CONFIG_OPP_DOMAIN_DISABLED;
+    ExpectedSustained = PM_CONFIG_OPP_DOMAIN_DISABLED;
+    for (CpuDomain = 0; CpuDomain < ARRAY_SIZE (mCpuDomains); CpuDomain++) {
+      Cpu = &mCpuDomains[CpuDomain];
+      if ((Cpu->Domain == Domain) &&
+          (Settings->CpuDomainEnabled[CpuDomain] != 0))
+      {
+        ExpectedSize      = Cpu->Size;
+        ExpectedSustained = Cpu->SustainedIndex;
+        break;
+      }
+    }
+
+    if ((PmRead16 (Buffer, PM_CONFIG_OPP_DOMAIN_OFFSET (Domain)) != ExpectedSize) ||
+        (PmRead16 (
+           Buffer,
+           PM_CONFIG_OPP_DOMAIN_OFFSET (Domain) + sizeof (UINT16)
+           ) != ExpectedSustained))
+    {
+      return FALSE;
+    }
+  }
+
+  return TRUE;
+}
+
+STATIC
+VOID
+PmExpectedOpp (
+  IN CONST RADXA_PM_TUNING_DATA  *Settings,
+  IN UINTN                       CpuDomain,
+  IN UINTN                       Opp,
+  OUT UINT16                     *Frequency,
+  OUT UINT16                     *Voltage,
+  OUT UINT32                     *Power
+  )
+{
+  CONST PM_CPU_DOMAIN_DATA  *Domain;
+  UINTN                     Index;
+  UINT8                     VoltageMode;
+
+  Domain     = &mCpuDomains[CpuDomain];
+  *Frequency = Domain->Frequency[Opp];
+  *Voltage   = Domain->Voltage[Opp];
+  VoltageMode = RADXA_PM_VOLTAGE_FIXED;
+
+  if ((Settings->Profile == RADXA_PM_PROFILE_GB1_2700) &&
+      (Domain->Domain == PM_CONFIG_GB1_DOMAIN_INDEX) &&
+      (Opp == PM_CONFIG_GB1_TOP_INDEX))
+  {
+    *Frequency = PM_CONFIG_GB1_2700_LEVEL;
+    *Voltage   = PM_CONFIG_GB1_2700_VOLTAGE;
+    VoltageMode = PM_CONFIG_GB1_2700_VMIN_MODE;
+  } else if (((Settings->Profile == RADXA_PM_PROFILE_CUSTOM) ||
+              (Settings->Profile == RADXA_PM_PROFILE_PARTIAL)) &&
+             (Opp != Domain->ProtectedIndex))
+  {
+    Index       = PmSettingsIndex (CpuDomain, Opp);
+    *Frequency  = Settings->CpuFrequency[Index];
+    *Voltage    = Settings->CpuVoltage[Index];
+    VoltageMode = Settings->CpuVoltageMode[Index];
+  } else if (Opp == Domain->ProtectedIndex) {
+    *Frequency = PM_CONFIG_CPU_BOOT_LEVEL;
+    *Voltage   = PM_CONFIG_CPU_BOOT_VOLTAGE;
+  }
+
+  *Power   = PmConservativePower (
+               Domain,
+               *Frequency,
+               *Voltage,
+               VoltageMode
+               );
+  *Voltage = PmEncodeVoltage (*Voltage, VoltageMode);
+}
+
+STATIC
+BOOLEAN
+PmProfileMatches (
+  IN CONST UINT8                 *Buffer,
+  IN CONST RADXA_PM_TUNING_DATA  *Settings
+  )
+{
+  CONST PM_CPU_DOMAIN_DATA  *Domain;
+  UINT16                    Frequency;
+  UINT32                    Power;
+  UINT16                    Voltage;
+  UINTN                     CpuDomain;
+  UINTN                     EntryOffset;
+  UINTN                     Opp;
+
+  if (Settings->Profile == RADXA_PM_PROFILE_VENDOR) {
+    return (Buffer[PM_CONFIG_OPP_VALID_OFFSET] == PM_CONFIG_OPP_EXTERNAL_INVALID);
+  }
+
+  if (Settings->Profile == RADXA_PM_PROFILE_PARTIAL) {
+    if ((Buffer[PM_CONFIG_OPP_VALID_OFFSET] != PM_CONFIG_OPP_EXTERNAL_PARTIAL) ||
+        !PmPartialTableHeadersMatch (Buffer, Settings))
+    {
+      return FALSE;
+    }
+  } else if ((Buffer[PM_CONFIG_OPP_VALID_OFFSET] != PM_CONFIG_OPP_EXTERNAL_VALID) ||
+             !PmFullTableHeadersMatch (Buffer))
+  {
+    return FALSE;
+  }
+
+  for (CpuDomain = 0; CpuDomain < ARRAY_SIZE (mCpuDomains); CpuDomain++) {
+    if ((Settings->Profile == RADXA_PM_PROFILE_PARTIAL) &&
+        (Settings->CpuDomainEnabled[CpuDomain] == 0))
+    {
+      continue;
+    }
+
+    Domain = &mCpuDomains[CpuDomain];
+    for (Opp = 0; Opp < Domain->Size; Opp++) {
+      PmExpectedOpp (Settings, CpuDomain, Opp, &Frequency, &Voltage, &Power);
+      EntryOffset = PM_CONFIG_OPP_ENTRY_OFFSET (Domain->Domain, Opp);
+      if ((PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_LEVEL_OFFSET) != Frequency) ||
+          (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_VOLTAGE_OFFSET) != Voltage) ||
+          (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_FREQUENCY_OFFSET) != 0) ||
+          (PmRead32 (Buffer, EntryOffset + PM_CONFIG_OPP_POWER_OFFSET) != Power))
+      {
+        return FALSE;
+      }
+    }
+  }
+
+  return TRUE;
+}
+
+STATIC
+VOID
+PmApplyProfile (
+  IN OUT UINT8                    *Buffer,
+  IN CONST RADXA_PM_TUNING_DATA   *Settings
+  )
+{
+  CONST PM_CPU_DOMAIN_DATA  *Domain;
+  UINT16                    Frequency;
+  UINT16                    Voltage;
+  UINT32                    Crc1;
+  UINT32                    Crc2;
+  UINT32                    Length;
+  UINT32                    Power;
+  UINTN                     CpuDomain;
+  UINTN                     EntryOffset;
+  UINTN                     Opp;
+
+  if (Settings->Profile == RADXA_PM_PROFILE_VENDOR) {
+    Buffer[PM_CONFIG_OPP_VALID_OFFSET] = PM_CONFIG_OPP_EXTERNAL_INVALID;
+  } else if (Settings->Profile == RADXA_PM_PROFILE_PARTIAL) {
+    Buffer[PM_CONFIG_OPP_VALID_OFFSET] = PM_CONFIG_OPP_EXTERNAL_PARTIAL;
+    PmSetPartialTableHeaders (Buffer, Settings);
+  } else {
+    Buffer[PM_CONFIG_OPP_VALID_OFFSET] = PM_CONFIG_OPP_EXTERNAL_VALID;
+    PmSetFullTableHeaders (Buffer);
+  }
+
+  if (Settings->Profile != RADXA_PM_PROFILE_VENDOR) {
+    for (CpuDomain = 0; CpuDomain < ARRAY_SIZE (mCpuDomains); CpuDomain++) {
+      if ((Settings->Profile == RADXA_PM_PROFILE_PARTIAL) &&
+          (Settings->CpuDomainEnabled[CpuDomain] == 0))
+      {
+        continue;
+      }
+
+      Domain = &mCpuDomains[CpuDomain];
+      for (Opp = 0; Opp < Domain->Size; Opp++) {
+        PmExpectedOpp (Settings, CpuDomain, Opp, &Frequency, &Voltage, &Power);
+        EntryOffset = PM_CONFIG_OPP_ENTRY_OFFSET (Domain->Domain, Opp);
+        PmWrite32 (Buffer, EntryOffset + PM_CONFIG_OPP_LEVEL_OFFSET, Frequency);
+        PmWrite32 (Buffer, EntryOffset + PM_CONFIG_OPP_VOLTAGE_OFFSET, Voltage);
+        PmWrite32 (Buffer, EntryOffset + PM_CONFIG_OPP_FREQUENCY_OFFSET, 0);
+        PmWrite32 (Buffer, EntryOffset + PM_CONFIG_OPP_POWER_OFFSET, Power);
+      }
+    }
+  }
+
+  Length = PmRead32 (Buffer, PM_CONFIG_LENGTH_OFFSET);
+  PmCalculateChecksum (Buffer, Length, &Crc1, &Crc2);
+  PmWrite32 (Buffer, PM_CONFIG_CRC1_OFFSET, Crc1);
+  PmWrite32 (Buffer, PM_CONFIG_CRC2_OFFSET, Crc2);
+}
+
+STATIC
+EFI_STATUS
+PmStoreSettings (
+  IN CONST RADXA_PM_TUNING_DATA  *Settings
+  )
+{
+  return gRT->SetVariable (
+                RADXA_PM_TUNING_VAR,
+                &gRadxaSetupVariableGuid,
+                EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS,
+                sizeof (*Settings),
+                (VOID *)Settings
+                );
+}
+
+STATIC
+EFI_STATUS
+PmGetSettings (
+  OUT RADXA_PM_TUNING_DATA  *Settings
+  )
+{
+  EFI_STATUS  Status;
+  BOOLEAN     StoreSettings;
+  UINTN       Size;
+
+  PmInitializeSettings (Settings);
+  StoreSettings = FALSE;
+  Size   = sizeof (*Settings);
+  Status = gRT->GetVariable (
+                  RADXA_PM_TUNING_VAR,
+                  &gRadxaSetupVariableGuid,
+                  NULL,
+                  &Size,
+                  Settings
+                  );
+  if (Status == EFI_NOT_FOUND) {
+    Status = PmStoreSettings (Settings);
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Cannot create setup variable: %r\n", Status));
+    }
+
+    return Status;
+  }
+
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Cannot read setup variable: %r\n", Status));
+    return Status;
+  }
+
+  if ((Size == sizeof (UINT8)) ||
+      (Size == RADXA_PM_TUNING_LEGACY_SIZE) ||
+      (Size == RADXA_PM_TUNING_V1_SIZE))
+  {
+    if (((Size == sizeof (UINT8)) &&
+         (Settings->Profile > RADXA_PM_PROFILE_GB1_2700)) ||
+        ((Size == RADXA_PM_TUNING_LEGACY_SIZE) &&
+         (Settings->Profile > RADXA_PM_PROFILE_CUSTOM)) ||
+        (Settings->Profile > RADXA_PM_PROFILE_MAX))
+    {
+      Settings->Profile = RADXA_PM_PROFILE_VENDOR;
+    }
+
+    Settings->Revision  = RADXA_PM_TUNING_REVISION;
+    Settings->DataSize  = sizeof (*Settings);
+    Settings->Signature = RADXA_PM_TUNING_SIGNATURE;
+    StoreSettings       = TRUE;
+  } else if (Size != sizeof (*Settings)) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Unexpected setup variable size: %u\n", (UINT32)Size));
+    return EFI_COMPROMISED_DATA;
+  }
+
+#if (PM_ENGINEERING_SUPPORT == 0)
+  if ((Settings->Profile == RADXA_PM_PROFILE_GB1_2700) ||
+      (Settings->Profile == RADXA_PM_PROFILE_CUSTOM))
+  {
+    Settings->Profile = RADXA_PM_PROFILE_VENDOR;
+    StoreSettings     = TRUE;
+  }
+#endif
+
+  if (StoreSettings) {
+    Status = PmStoreSettings (Settings);
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Cannot migrate setup variable: %r\n", Status));
+      return Status;
+    }
+  }
+
+  if (!PmSettingsAreValid (Settings)) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Invalid PM tuning settings\n"));
+    return EFI_COMPROMISED_DATA;
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+PmReadFlash (
+  IN CIX_FW_UPDATE_PROTOCOL  *FwUpdate,
+  OUT UINT8                  *Buffer
+  )
+{
+  UINTN   Size;
+  UINT16  Result;
+
+  Size   = PM_CONFIG_BIN_SIZE;
+  Result = FwUpdate->FirmwareRawEntryUpdate (
+                       FIRMWARE_TYPE_PM_CONF,
+                       Buffer,
+                       &Size,
+                       ENTRY_READ,
+                       NULL
+                       );
+
+  // The vendor read implementation may return an undefined low status byte.
+  // Validate the returned buffer instead of trusting Result alone.
+  DEBUG ((
+    DEBUG_INFO,
+    "[PmConfigUpdate] PM read result: 0x%x, size: %u\n",
+    Result,
+    (UINT32)Size
+    ));
+  if ((Size != PM_CONFIG_BIN_SIZE) || !PmValidateConfig (Buffer)) {
+    return EFI_COMPROMISED_DATA;
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+PmWriteAndVerify (
+  IN CIX_FW_UPDATE_PROTOCOL  *FwUpdate,
+  IN CONST UINT8             *Expected
+  )
+{
+  EFI_STATUS  Status;
+  UINT8       *Verify;
+  UINTN       Size;
+  UINT16      Result;
+
+  Size   = PM_CONFIG_BIN_SIZE;
+  Result = FwUpdate->FirmwareRawEntryUpdate (
+                       FIRMWARE_TYPE_PM_CONF,
+                       (UINT8 *)Expected,
+                       &Size,
+                       ENTRY_WRITE,
+                       NULL
+                       );
+  if ((Result & 0xFF) != FIRMWARE_RET_SUCCESS) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] PM write failed: 0x%x\n", Result));
+    return EFI_DEVICE_ERROR;
+  }
+
+  Verify = AllocateZeroPool (PM_CONFIG_BIN_SIZE);
+  if (Verify == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  Status = PmReadFlash (FwUpdate, Verify);
+  if (!EFI_ERROR (Status) &&
+      (CompareMem (Verify, Expected, PM_CONFIG_BIN_SIZE) != 0))
+  {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] PM write read-back mismatch\n"));
+    Status = EFI_DEVICE_ERROR;
+  }
+
+  FreePool (Verify);
+  return Status;
+}
+
+EFI_STATUS
+EFIAPI
+PmConfigUpdateDxeEntryPoint (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS            Status;
+  CIX_FW_UPDATE_PROTOCOL  *FwUpdate;
+  RADXA_PM_TUNING_DATA  Settings;
+  UINT8                 *Buffer;
+
+  Status = PmGetSettings (&Settings);
+  if (EFI_ERROR (Status)) {
+    return EFI_SUCCESS;
+  }
+
+  Status = gBS->LocateProtocol (
+                  &gCixFirmwareUpdateProtocolGuid,
+                  NULL,
+                  (VOID **)&FwUpdate
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Firmware update protocol unavailable: %r\n", Status));
+    return EFI_SUCCESS;
+  }
+
+  Buffer = AllocateZeroPool (PM_CONFIG_BIN_SIZE);
+  if (Buffer == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  Status = PmReadFlash (FwUpdate, Buffer);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Refusing to modify invalid PM config\n"));
+    FreePool (Buffer);
+    return EFI_SUCCESS;
+  }
+
+  if (PmProfileMatches (Buffer, &Settings)) {
+    DEBUG ((DEBUG_INFO, "[PmConfigUpdate] Profile %u already active\n", Settings.Profile));
+    FreePool (Buffer);
+    return EFI_SUCCESS;
+  }
+
+  PmApplyProfile (Buffer, &Settings);
+  if (!PmValidateConfig (Buffer) || !PmProfileMatches (Buffer, &Settings)) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Refusing to write invalid generated config\n"));
+    FreePool (Buffer);
+    return EFI_SUCCESS;
+  }
+
+  Status = PmWriteAndVerify (FwUpdate, Buffer);
+  FreePool (Buffer);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] PM update verification failed: %r\n", Status));
+    return EFI_SUCCESS;
+  }
+
+  DEBUG ((DEBUG_INFO, "[PmConfigUpdate] Profile %u written; cold resetting\n", Settings.Profile));
+  gRT->ResetSystem (EfiResetCold, EFI_SUCCESS, 0, NULL);
+  CpuDeadLoop ();
+  return EFI_SUCCESS;
+}
diff --git a/Platform/CIX/Sky1/Drivers/PmConfigUpdateDxe/PmConfigUpdateDxe.h b/Platform/CIX/Sky1/Drivers/PmConfigUpdateDxe/PmConfigUpdateDxe.h
