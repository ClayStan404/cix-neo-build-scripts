+    subtitle text = STRING_TOKEN(STR_PM_OPP6);
+    PM_FREQ_LAST(19, 18, 2600)
+    PM_VOLT_LAST(19, 18, 920)
+    subtitle text = STRING_TOKEN(STR_EMPTY_STRING);
+
+    subtitle text = STRING_TOKEN(STR_PM_DOMAIN_GM0);
+    subtitle text = STRING_TOKEN(STR_PM_OPP0);
+    PM_FREQ_FIRST(26, 27, 800)
