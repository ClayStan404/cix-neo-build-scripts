+++ b/Platform/CIX/Sky1/Drivers/PmConfigUpdateDxe/PmConfigUpdateDxe.c
@@ -0,0 +1,443 @@
+/** @file
+  Update the CIX v3 PM configuration from a validated BIOS profile.
+
+  The PM firmware consumes the dedicated 4 KiB PM configuration before UEFI
+  starts. This DXE driver therefore updates that region, verifies the write,
+  and requests a cold reset so the selected profile is consumed on next boot.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "PmConfigUpdateDxe.h"
+
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+
+STATIC
+UINT16
+PmRead16 (
+  IN CONST UINT8  *Buffer,
+  IN UINTN        Offset
+  )
+{
+  UINT16  Value;
+
+  CopyMem (&Value, Buffer + Offset, sizeof (Value));
+  return Value;
+}
+
+STATIC
+UINT32
+PmRead32 (
+  IN CONST UINT8  *Buffer,
+  IN UINTN        Offset
+  )
+{
+  UINT32  Value;
+
+  CopyMem (&Value, Buffer + Offset, sizeof (Value));
+  return Value;
+}
+
+STATIC
+VOID
+PmWrite32 (
+  IN OUT UINT8  *Buffer,
+  IN UINTN      Offset,
+  IN UINT32     Value
+  )
+{
+  CopyMem (Buffer + Offset, &Value, sizeof (Value));
+}
+
+STATIC
+VOID
+PmCalculateChecksum (
+  IN CONST UINT8  *Buffer,
+  IN UINT32       Length,
+  OUT UINT32      *Crc1,
+  OUT UINT32      *Crc2
+  )
+{
+  UINT32  Cka;
+  UINT32  Ckb;
+  UINT32  Offset;
+  UINT32  Word;
+
+  Cka = 0;
+  Ckb = 0;
+  for (Offset = 0; Offset < Length; Offset += sizeof (UINT32)) {
+    if ((Offset == PM_CONFIG_CRC1_OFFSET) ||
+        (Offset == PM_CONFIG_CRC2_OFFSET))
+    {
+      Word = 0;
+    } else {
+      Word = PmRead32 (Buffer, Offset);
+    }
+
+    Cka += Word;
+    Ckb += Cka;
+  }
+
+  *Crc1 = Cka;
+  *Crc2 = Ckb;
+}
+
+STATIC
+BOOLEAN
+PmTopOppIsKnown (
+  IN CONST UINT8  *Buffer
+  )
+{
+  UINT32  Level;
+  UINT32  Voltage;
+  UINT32  Frequency;
+  UINT32  Power;
+
+  Level = PmRead32 (
+            Buffer,
+            PM_CONFIG_GB1_TOP_OFFSET + PM_CONFIG_OPP_LEVEL_OFFSET
+            );
+  Voltage = PmRead32 (
+              Buffer,
+              PM_CONFIG_GB1_TOP_OFFSET + PM_CONFIG_OPP_VOLTAGE_OFFSET
+              );
+  Frequency = PmRead32 (
+                Buffer,
+                PM_CONFIG_GB1_TOP_OFFSET + PM_CONFIG_OPP_FREQUENCY_OFFSET
+                );
+  Power = PmRead32 (
+            Buffer,
+            PM_CONFIG_GB1_TOP_OFFSET + PM_CONFIG_OPP_POWER_OFFSET
+            );
+
+  if ((Frequency != 0) || (Power != PM_CONFIG_GB1_TOP_POWER)) {
+    return FALSE;
+  }
+
+  return (((Level == PM_CONFIG_GB1_STOCK_LEVEL) &&
+           (Voltage == PM_CONFIG_GB1_STOCK_VOLTAGE)) ||
+          ((Level == PM_CONFIG_GB1_2700_LEVEL) &&
+           (Voltage == PM_CONFIG_GB1_2700_VOLTAGE)));
+}
+
+STATIC
+BOOLEAN
+PmValidateConfig (
+  IN CONST UINT8  *Buffer
+  )
+{
+  UINT32  Length;
+  UINT32  ExpectedCrc1;
+  UINT32  ExpectedCrc2;
+
+  if ((PmRead16 (Buffer, PM_CONFIG_VERSION_MAJOR_OFFSET) !=
+       PM_CONFIG_VERSION_MAJOR) ||
+      (PmRead16 (Buffer, PM_CONFIG_VERSION_MINOR_OFFSET) !=
+       PM_CONFIG_VERSION_MINOR) ||
+      (PmRead32 (Buffer, PM_CONFIG_SIGNATURE_OFFSET) != PM_CONFIG_SIGNATURE))
+  {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Unsupported PM config header\n"));
+    return FALSE;
+  }
+
+  Length = PmRead32 (Buffer, PM_CONFIG_LENGTH_OFFSET);
+  if ((Length < PM_CONFIG_GB1_TOP_END) ||
+      (Length > PM_CONFIG_BIN_SIZE) ||
+      ((Length & (sizeof (UINT32) - 1)) != 0))
+  {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Invalid PM config length: %u\n", Length));
+    return FALSE;
+  }
+
+  PmCalculateChecksum (Buffer, Length, &ExpectedCrc1, &ExpectedCrc2);
+  if ((PmRead32 (Buffer, PM_CONFIG_CRC1_OFFSET) != ExpectedCrc1) ||
+      (PmRead32 (Buffer, PM_CONFIG_CRC2_OFFSET) != ExpectedCrc2))
+  {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] PM config checksum mismatch\n"));
+    return FALSE;
+  }
+
+  if ((Buffer[PM_CONFIG_OPP_VALID_OFFSET] != 0) ||
+      (PmRead16 (Buffer, PM_CONFIG_GB1_DOMAIN_OFFSET) !=
+       PM_CONFIG_GB1_SIZE) ||
+      (PmRead16 (Buffer, PM_CONFIG_GB1_DOMAIN_OFFSET + sizeof (UINT16)) !=
+       PM_CONFIG_GB1_SUSTAINED_INDEX) ||
+      !PmTopOppIsKnown (Buffer))
+  {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Unsupported GB1 OPP table\n"));
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+STATIC
+BOOLEAN
+PmProfileMatches (
+  IN CONST UINT8  *Buffer,
+  IN UINT8        Profile
+  )
+{
+  UINT32  ExpectedLevel;
+  UINT32  ExpectedVoltage;
+
+  if (Profile == RADXA_PM_PROFILE_STOCK) {
+    ExpectedLevel   = PM_CONFIG_GB1_STOCK_LEVEL;
+    ExpectedVoltage = PM_CONFIG_GB1_STOCK_VOLTAGE;
+  } else {
+    ExpectedLevel   = PM_CONFIG_GB1_2700_LEVEL;
+    ExpectedVoltage = PM_CONFIG_GB1_2700_VOLTAGE;
+  }
+
+  return ((PmRead32 (
+             Buffer,
+             PM_CONFIG_GB1_TOP_OFFSET + PM_CONFIG_OPP_LEVEL_OFFSET
+             ) == ExpectedLevel) &&
+          (PmRead32 (
+             Buffer,
+             PM_CONFIG_GB1_TOP_OFFSET + PM_CONFIG_OPP_VOLTAGE_OFFSET
+             ) == ExpectedVoltage));
+}
+
+STATIC
+VOID
+PmApplyProfile (
+  IN OUT UINT8  *Buffer,
+  IN UINT8      Profile
+  )
+{
+  UINT32  Level;
+  UINT32  Voltage;
+  UINT32  Length;
+  UINT32  Crc1;
+  UINT32  Crc2;
+
+  if (Profile == RADXA_PM_PROFILE_STOCK) {
+    Level   = PM_CONFIG_GB1_STOCK_LEVEL;
+    Voltage = PM_CONFIG_GB1_STOCK_VOLTAGE;
+  } else {
+    Level   = PM_CONFIG_GB1_2700_LEVEL;
+    Voltage = PM_CONFIG_GB1_2700_VOLTAGE;
+  }
+
+  PmWrite32 (
+    Buffer,
+    PM_CONFIG_GB1_TOP_OFFSET + PM_CONFIG_OPP_LEVEL_OFFSET,
+    Level
+    );
+  PmWrite32 (
+    Buffer,
+    PM_CONFIG_GB1_TOP_OFFSET + PM_CONFIG_OPP_VOLTAGE_OFFSET,
+    Voltage
+    );
+  PmWrite32 (
+    Buffer,
+    PM_CONFIG_GB1_TOP_OFFSET + PM_CONFIG_OPP_FREQUENCY_OFFSET,
+    0
+    );
+  PmWrite32 (
+    Buffer,
+    PM_CONFIG_GB1_TOP_OFFSET + PM_CONFIG_OPP_POWER_OFFSET,
+    PM_CONFIG_GB1_TOP_POWER
+    );
+
+  Length = PmRead32 (Buffer, PM_CONFIG_LENGTH_OFFSET);
+  PmCalculateChecksum (Buffer, Length, &Crc1, &Crc2);
+  PmWrite32 (Buffer, PM_CONFIG_CRC1_OFFSET, Crc1);
+  PmWrite32 (Buffer, PM_CONFIG_CRC2_OFFSET, Crc2);
+}
+
+STATIC
+EFI_STATUS
+PmGetProfile (
+  OUT UINT8  *Profile
+  )
+{
+  EFI_STATUS            Status;
+  UINTN                 Size;
+  RADXA_PM_TUNING_DATA  Setup;
+
+  Size = sizeof (Setup);
+  ZeroMem (&Setup, sizeof (Setup));
+  Status = gRT->GetVariable (
+                  RADXA_PM_TUNING_VAR,
+                  &gRadxaSetupVariableGuid,
+                  NULL,
+                  &Size,
+                  &Setup
+                  );
+  if (Status == EFI_NOT_FOUND) {
+    Setup.Gb1Profile = RADXA_PM_PROFILE_STOCK;
+    Status = gRT->SetVariable (
+                    RADXA_PM_TUNING_VAR,
+                    &gRadxaSetupVariableGuid,
+                    EFI_VARIABLE_NON_VOLATILE |
+                    EFI_VARIABLE_BOOTSERVICE_ACCESS,
+                    sizeof (Setup),
+                    &Setup
+                    );
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Cannot create setup variable: %r\n", Status));
+      return Status;
+    }
+  } else if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Cannot read setup variable: %r\n", Status));
+    return Status;
+  }
+
+  if ((Size != sizeof (Setup)) ||
+      (Setup.Gb1Profile > RADXA_PM_PROFILE_MAX))
+  {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Invalid setup profile\n"));
+    return EFI_COMPROMISED_DATA;
+  }
+
+  *Profile = Setup.Gb1Profile;
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+PmReadFlash (
+  IN CIX_FW_UPDATE_PROTOCOL  *FwUpdate,
+  OUT UINT8                  *Buffer
+  )
+{
+  UINTN   Size;
+  UINT16  Result;
+
+  Size   = PM_CONFIG_BIN_SIZE;
+  Result = FwUpdate->FirmwareRawEntryUpdate (
+                       FIRMWARE_TYPE_PM_CONF,
+                       Buffer,
+                       &Size,
+                       ENTRY_READ,
+                       NULL
+                       );
+
+  // The vendor read implementation may return an undefined low status byte.
+  // Validate the returned buffer instead of trusting Result alone.
+  DEBUG ((
+    DEBUG_INFO,
+    "[PmConfigUpdate] PM read result: 0x%x, size: %u\n",
+    Result,
+    (UINT32)Size
+    ));
+  if ((Size != PM_CONFIG_BIN_SIZE) || !PmValidateConfig (Buffer)) {
+    return EFI_COMPROMISED_DATA;
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+PmWriteAndVerify (
+  IN CIX_FW_UPDATE_PROTOCOL  *FwUpdate,
+  IN CONST UINT8             *Expected
+  )
+{
+  EFI_STATUS  Status;
+  UINT8       *Verify;
+  UINTN       Size;
+  UINT16      Result;
+
+  Size   = PM_CONFIG_BIN_SIZE;
+  Result = FwUpdate->FirmwareRawEntryUpdate (
+                       FIRMWARE_TYPE_PM_CONF,
+                       (UINT8 *)Expected,
+                       &Size,
+                       ENTRY_WRITE,
+                       NULL
+                       );
+  if ((Result & 0xFF) != FIRMWARE_RET_SUCCESS) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] PM write failed: 0x%x\n", Result));
+    return EFI_DEVICE_ERROR;
+  }
+
+  Verify = AllocateZeroPool (PM_CONFIG_BIN_SIZE);
+  if (Verify == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  Status = PmReadFlash (FwUpdate, Verify);
+  if (!EFI_ERROR (Status) &&
+      (CompareMem (Verify, Expected, PM_CONFIG_BIN_SIZE) != 0))
+  {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] PM write read-back mismatch\n"));
+    Status = EFI_DEVICE_ERROR;
+  }
+
+  FreePool (Verify);
+  return Status;
+}
+
+EFI_STATUS
+EFIAPI
+PmConfigUpdateDxeEntryPoint (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS              Status;
+  CIX_FW_UPDATE_PROTOCOL  *FwUpdate;
+  UINT8                   *Buffer;
+  UINT8                   Profile;
+
+  Status = PmGetProfile (&Profile);
+  if (EFI_ERROR (Status)) {
+    return EFI_SUCCESS;
+  }
+
+  Status = gBS->LocateProtocol (
+                  &gCixFirmwareUpdateProtocolGuid,
+                  NULL,
+                  (VOID **)&FwUpdate
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Firmware update protocol unavailable: %r\n", Status));
+    return EFI_SUCCESS;
+  }
+
+  Buffer = AllocateZeroPool (PM_CONFIG_BIN_SIZE);
+  if (Buffer == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  Status = PmReadFlash (FwUpdate, Buffer);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Refusing to modify invalid PM config\n"));
+    FreePool (Buffer);
+    return EFI_SUCCESS;
+  }
+
+  if (PmProfileMatches (Buffer, Profile)) {
+    DEBUG ((DEBUG_INFO, "[PmConfigUpdate] Profile %u already active\n", Profile));
+    FreePool (Buffer);
+    return EFI_SUCCESS;
+  }
+
+  PmApplyProfile (Buffer, Profile);
+  if (!PmValidateConfig (Buffer)) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] Refusing to write invalid generated config\n"));
+    FreePool (Buffer);
+    return EFI_SUCCESS;
+  }
+
+  Status = PmWriteAndVerify (FwUpdate, Buffer);
+  FreePool (Buffer);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "[PmConfigUpdate] PM update verification failed: %r\n", Status));
+    return EFI_SUCCESS;
+  }
+
+  DEBUG ((DEBUG_INFO, "[PmConfigUpdate] Profile %u written; cold resetting\n", Profile));
+  gRT->ResetSystem (EfiResetCold, EFI_SUCCESS, 0, NULL);
+  CpuDeadLoop ();
+  return EFI_SUCCESS;
+}
