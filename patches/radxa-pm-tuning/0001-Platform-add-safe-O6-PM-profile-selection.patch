+STATIC
+VOID
+ApplyPmProfileCpuLimit (
+  IN OUT RADXA_SETUP_DATA  *RadxaSetupData
+  )
+{
+  EFI_STATUS            Status;
+  UINTN                 Size;
+  RADXA_PM_TUNING_DATA  PmTuningData;
+
+  ZeroMem (&PmTuningData, sizeof (PmTuningData));
+  Size = sizeof (PmTuningData);
+  Status = gRT->GetVariable (
+                  RADXA_PM_TUNING_VAR,
+                  &gRadxaSetupVariableGuid,
+                  NULL,
+                  &Size,
+                  &PmTuningData
+                  );
+  if (Status == EFI_NOT_FOUND) {
+    return;
+  }
+
+  if (EFI_ERROR (Status) ||
+      ((Size != sizeof (PmTuningData)) && (Size != sizeof (UINT8))) ||
+      (PmTuningData.Profile > RADXA_PM_PROFILE_MAX))
+  {
+    DEBUG ((DEBUG_ERROR, "Invalid PM tuning profile: %r\n", Status));
+    return;
+  }
+
+  if (PmTuningData.Profile == RADXA_PM_PROFILE_STOCK) {
+    RadxaSetupData->CpuFMax = RADXA_CPU_LIMIT_2600;
+  } else {
+    RadxaSetupData->CpuFMax = RADXA_CPU_LIMIT_MAX;
+  }
+}
