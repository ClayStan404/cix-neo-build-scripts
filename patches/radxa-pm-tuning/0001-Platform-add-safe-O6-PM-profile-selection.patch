+    subtitle text = STRING_TOKEN(STR_PM_OPP2);
+    PM_FREQ_BEFORE_STARTUP(15, 14, 1500)
+    PM_VOLT_BEFORE_STARTUP(15, 14, 750)
+    subtitle text = STRING_TOKEN(STR_PM_OPP4);
+    PM_FREQ_AFTER_STARTUP(17, 18, 2200)
