diff --git a/core/arch/arm/plat-cix/main.c b/core/arch/arm/plat-cix/main.c
--- a/core/arch/arm/plat-cix/main.c
+++ b/core/arch/arm/plat-cix/main.c
@@ -253,12 +253,16 @@ void platform_get_te_configs(void **base, int *irq, int *host)
 TEE_Result tee_otp_get_ta_enc_key(uint32_t key_type __maybe_unused,
 					 uint8_t *buffer, size_t len)
 {
-	size_t key_len = 32;
+	const uint32_t key_len = 32;
+	uint32_t response_len = 0;
 	TEE_Result ret;
 
-	ret = cix_get_key_info(KEY_ID_MODEL_KEY, key_len, buffer, &len);
-	EMSG_RAW("Cix_en_key: %d\n", key_len);
-	DHEXDUMP(buffer, 32);
+	if (!buffer || len < key_len)
+		return TEE_ERROR_SHORT_BUFFER;
+
+	ret = cix_get_key_info(KEY_ID_MODEL_KEY, key_len, buffer, &response_len);
+	EMSG_RAW("Cix_en_key: %u\n", (unsigned int)response_len);
+	DHEXDUMP(buffer, key_len);
 
 	return ret;
 }
