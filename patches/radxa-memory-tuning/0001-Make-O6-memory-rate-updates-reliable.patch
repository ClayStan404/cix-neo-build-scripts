From 97a3fd116c6f7759a23b06a178a9095897d3938f Mon Sep 17 00:00:00 2001
From: Clay Stan <claystan97@gmail.com>
Date: Tue, 25 Aug 2026 18:57:30 +0800
Subject: [PATCH] Make O6 memory rate updates reliable

Change-Id: I8f4b85bf29dd6089a6d7c643ec4c6fe854765ecb
---
 .../FirmwareUpdateDxe/FwUpdateProtocolDxe.c   |   2 +-
 .../MemConfigUpdateDxe/MemConfigUpdateDxe.c   | 134 +++++++++++++++---
 .../MemMenu/MemoryConfig.uni                  |   2 +-
 3 files changed, 119 insertions(+), 19 deletions(-)

diff --git a/Platform/CIX/Sky1/Drivers/FirmwareUpdateDxe/FwUpdateProtocolDxe.c b/Platform/CIX/Sky1/Drivers/FirmwareUpdateDxe/FwUpdateProtocolDxe.c
index e68b7c68..ead9636f 100644
--- a/Platform/CIX/Sky1/Drivers/FirmwareUpdateDxe/FwUpdateProtocolDxe.c
+++ b/Platform/CIX/Sky1/Drivers/FirmwareUpdateDxe/FwUpdateProtocolDxe.c
@@ -975,7 +975,7 @@ CixFirmwareRawEntryUpdate (
 {
   EFI_STATUS               Status = EFI_SUCCESS;
   UINT32                   dwflag = 0;
-  UINT8                    RetVal;
+  UINT8                    RetVal = FIRMWARE_RET_SUCCESS;
   UINT8                    *pImageBuffer;
   UINT16                   ReturnCode;
   UINT32                   Index;
diff --git a/Platform/CIX/Sky1/Drivers/MemConfigUpdateDxe/MemConfigUpdateDxe.c b/Platform/CIX/Sky1/Drivers/MemConfigUpdateDxe/MemConfigUpdateDxe.c
index 4aecb441..0838aae9 100644
--- a/Platform/CIX/Sky1/Drivers/MemConfigUpdateDxe/MemConfigUpdateDxe.c
+++ b/Platform/CIX/Sky1/Drivers/MemConfigUpdateDxe/MemConfigUpdateDxe.c
@@ -12,6 +12,8 @@
 MEM_CONFIG_BLOCK_TABLE_ENTRY  *mCdcbBlockEntry = NULL;
 UINT8                         mCdcbBlockCount  = 0;
 
+#define O6_MEMORY_FREQUENCY_AUTO  0xFFFFU
+
 // EFI_STATUS
 // CdcbLoadBuffer (
 //   UINT8  **buf,
@@ -89,6 +91,30 @@ GenCheckSum (
   return ~CheckSum;
 }
 
+STATIC
+BOOLEAN
+O6MemoryFrequencyIsValid (
+  IN UINT16  Frequency
+  )
+{
+  switch (Frequency) {
+    case 800:
+    case 1067:
+    case 1375:
+    case 1600:
+    case 1867:
+    case 2133:
+    case 2400:
+    case 2750:
+    case 3000:
+    case 3200:
+    case O6_MEMORY_FREQUENCY_AUTO:
+      return TRUE;
+    default:
+      return FALSE;
+  }
+}
+
 EFI_STATUS
 GetBlockBufWithGuid (
   uint32_t  guid,
@@ -112,15 +138,22 @@ EFI_STATUS
 GetMemConfigBiosBlockAndUpdate (
   PLATFORM_SETUP_DATA  *pPlatformSetupData,
   UINT8                *pImage,
+  UINTN                ImageSize,
   BOOLEAN              *Update
   )
 {
   MEM_CONFIG_HEADER      *GlobalHeader;
   MEM_CONFIG_BIOS_SETUP  *MemConfigBiosSetup;
+  UINTN                  BlockOffset;
+  UINTN                  BlockTableSize;
   BOOLEAN                Found = FALSE;
-  UINT16                 Offset;
   UINT8                  Val8;
 
+  if (ImageSize < (CDCB_MEM_CONFIG_HEADER_OFFSET + sizeof (*GlobalHeader))) {
+    DEBUG ((DEBUG_ERROR, "Memory configuration image is too small\n"));
+    return EFI_COMPROMISED_DATA;
+  }
+
   GlobalHeader = (MEM_CONFIG_HEADER *)(pImage + CDCB_MEM_CONFIG_HEADER_OFFSET);
   if (GlobalHeader->Signature != MEM_CONFIG_HEADER_SIGNATURE) {
     // DDR_DRV_PRINT(BASE_INFO, "Error: Incorrect CDCB header signature!\n");
@@ -128,28 +161,63 @@ GetMemConfigBiosBlockAndUpdate (
     return EFI_NOT_FOUND;
   }
 
+  if ((GlobalHeader->HeaderSize != sizeof (*GlobalHeader)) ||
+      (GlobalHeader->BlockTbOffset != sizeof (*GlobalHeader)) ||
+      (GlobalHeader->TotalSize < sizeof (*GlobalHeader)) ||
+      (GlobalHeader->TotalSize > (ImageSize - CDCB_MEM_CONFIG_HEADER_OFFSET)))
+  {
+    DEBUG ((DEBUG_ERROR, "Invalid memory configuration header layout\n"));
+    return EFI_COMPROMISED_DATA;
+  }
+
   if (!CdcbValidateChecksum ((UINT8 *)GlobalHeader, GlobalHeader->HeaderSize)) {
     // DDR_DRV_PRINT(BASE_INFO, "Error: CDCB header checksum failed!\n");
     DEBUG ((DEBUG_ERROR, "Error: CDCB header checksum failed!\n"));
     return EFI_NOT_FOUND;
   }
 
+  ImageSize = CDCB_MEM_CONFIG_HEADER_OFFSET + GlobalHeader->TotalSize;
+
   mCdcbBlockCount = GlobalHeader->BlockCount;
+  BlockTableSize  = (UINTN)mCdcbBlockCount * sizeof (*mCdcbBlockEntry);
+  if ((CDCB_MEM_CONFIG_BLOCK_TABLE_OFFSET > ImageSize) ||
+      (BlockTableSize > (ImageSize - CDCB_MEM_CONFIG_BLOCK_TABLE_OFFSET)))
+  {
+    DEBUG ((DEBUG_ERROR, "Memory configuration block table is outside the image\n"));
+    return EFI_COMPROMISED_DATA;
+  }
+
   mCdcbBlockEntry = (MEM_CONFIG_BLOCK_TABLE_ENTRY *)(pImage + CDCB_MEM_CONFIG_BLOCK_TABLE_OFFSET);
   for (UINT8 Index = 0; Index < mCdcbBlockCount; Index++) {
     DEBUG ((DEBUG_INFO, "GUID:%X Offset:%x\n", mCdcbBlockEntry[Index].Guid, mCdcbBlockEntry[Index].Offset));
     if (mCdcbBlockEntry[Index].Guid == MEM_CONFIG_BLOCK_BIOS_SETUP_GUID) {
-      Found  = TRUE;
-      Offset = mCdcbBlockEntry[Index].Offset;
+      Found       = TRUE;
+      BlockOffset = CDCB_MEM_CONFIG_HEADER_OFFSET + mCdcbBlockEntry[Index].Offset;
       break;
     }
   }
 
   if (Found) {
-    MemConfigBiosSetup = (MEM_CONFIG_BIOS_SETUP *)(pImage + CDCB_MEM_CONFIG_HEADER_OFFSET + Offset);
-    if (MemConfigBiosSetup->Header.Signature != MEM_CONFIG_BLOCK_BIOS_SETUP_SIGNATURE) {
-      DEBUG ((DEBUG_ERROR, "Error: Incorrect BSET header signature!\n"));
-      return EFI_NOT_FOUND;
+    if ((BlockOffset > ImageSize) ||
+        ((ImageSize - BlockOffset) < sizeof (*MemConfigBiosSetup)))
+    {
+      DEBUG ((DEBUG_ERROR, "Memory BSET block is outside the image\n"));
+      return EFI_COMPROMISED_DATA;
+    }
+
+    MemConfigBiosSetup = (MEM_CONFIG_BIOS_SETUP *)(pImage + BlockOffset);
+    if ((MemConfigBiosSetup->Header.Signature != MEM_CONFIG_BLOCK_BIOS_SETUP_SIGNATURE) ||
+        (MemConfigBiosSetup->Header.BlockSize < sizeof (*MemConfigBiosSetup)) ||
+        (MemConfigBiosSetup->Header.BlockSize > (ImageSize - BlockOffset)) ||
+        !CdcbValidateChecksum ((UINT8 *)MemConfigBiosSetup, MemConfigBiosSetup->Header.BlockSize))
+    {
+      DEBUG ((DEBUG_ERROR, "Error: Invalid BSET block\n"));
+      return EFI_COMPROMISED_DATA;
+    }
+
+    if (!O6MemoryFrequencyIsValid (pPlatformSetupData->MemFreq)) {
+      DEBUG ((DEBUG_ERROR, "Invalid O6 memory frequency: %u\n", pPlatformSetupData->MemFreq));
+      return EFI_INVALID_PARAMETER;
     }
 
     if (pPlatformSetupData->MemFreq != MemConfigBiosSetup->MemFreq) {
@@ -291,7 +359,7 @@ GetMemConfigBiosBlockAndUpdate (
     }
   }
 
-  return EFI_SUCCESS;
+  return Found ? EFI_SUCCESS : EFI_NOT_FOUND;
 }
 
 VOID
@@ -301,8 +369,12 @@ MemConfigUpdateCallback (
   )
 {
   EFI_STATUS              Status;
-  UINT8                   *pImage;
+  UINT8                   *pImage               = NULL;
+  UINT8                   *pVerifyImage         = NULL;
   UINTN                   Length               = 0x1000;
+  UINTN                   ExpectedLength;
+  UINTN                   VerifyLength;
+  UINT16                  Result;
   BOOLEAN                 Update               = FALSE;
   UINTN                   VarSize              = 0;
   PLATFORM_SETUP_DATA     *pPlatformSetupVar   = NULL;
@@ -367,16 +439,16 @@ MemConfigUpdateCallback (
   }
 
   DEBUG ((DEBUG_INFO, "Debug-------------------------------------------------------[%a][%d]\n", __FUNCTION__, __LINE__));
-  Status = FlashUpdateProtocol->FirmwareRawEntryUpdate (FIRMWARE_TYPE_MEM_CONF, pImage, &Length, ENTRY_READ, NULL);
-  if (EFI_ERROR (Status)) {
-    DEBUG ((DEBUG_ERROR, "[%a][%d]: FirmwareRawEntryUpdate Read failed: %r\n", __FUNCTION__, __LINE__, Status));
+  Result = FlashUpdateProtocol->FirmwareRawEntryUpdate (FIRMWARE_TYPE_MEM_CONF, pImage, &Length, ENTRY_READ, NULL);
+  if ((Result & 0xFF) != FIRMWARE_RET_SUCCESS) {
+    DEBUG ((DEBUG_ERROR, "[%a][%d]: FirmwareRawEntryUpdate Read failed: 0x%x\n", __FUNCTION__, __LINE__, Result));
     goto Done;
   }
 
   DEBUG ((DEBUG_INFO, "Debug-------------------------------------------------------[%a][%d]\n", __FUNCTION__, __LINE__));
   DEBUG ((DEBUG_INFO, "[%a][%d]: FirmwareRawEntryUpdate Read success\n", __FUNCTION__, __LINE__));
   DEBUG ((DEBUG_INFO, "Debug-------------------------------------------------------[%a][%d]\n", __FUNCTION__, __LINE__));
-  Status = GetMemConfigBiosBlockAndUpdate (pPlatformSetupVar, pImage, &Update);
+  Status = GetMemConfigBiosBlockAndUpdate (pPlatformSetupVar, pImage, Length, &Update);
   if (EFI_ERROR (Status)) {
     DEBUG ((DEBUG_INFO, "GetMemConfigBiosBlockAndUpdate Status:%r\n", Status));
     goto Done;
@@ -384,12 +456,36 @@ MemConfigUpdateCallback (
 
   DEBUG ((DEBUG_INFO, "Debug-------------------------------------------------------[%a][%d]\n", __FUNCTION__, __LINE__));
   if (Update) {
-    // UpdateCheckSum (pPmConfig);
-    Status = FlashUpdateProtocol->FirmwareRawEntryUpdate (FIRMWARE_TYPE_MEM_CONF, pImage, &Length, ENTRY_WRITE, NULL);
-    if (EFI_ERROR (Status)) {
-      DEBUG ((DEBUG_ERROR, "[%a][%d]: FirmwareRawEntryUpdate write failed: %r\n", __FUNCTION__, __LINE__, Status));
+    ExpectedLength = Length;
+    Result = FlashUpdateProtocol->FirmwareRawEntryUpdate (FIRMWARE_TYPE_MEM_CONF, pImage, &Length, ENTRY_WRITE, NULL);
+    if ((Result & 0xFF) != FIRMWARE_RET_SUCCESS) {
+      DEBUG ((DEBUG_ERROR, "[%a][%d]: FirmwareRawEntryUpdate write failed: 0x%x\n", __FUNCTION__, __LINE__, Result));
+      goto Done;
+    }
+
+    VerifyLength = ExpectedLength;
+    pVerifyImage = AllocateZeroPool (VerifyLength);
+    if (pVerifyImage == NULL) {
+      DEBUG ((DEBUG_ERROR, "[%a][%d]: Allocate read-back buffer failed\n", __FUNCTION__, __LINE__));
+      goto Done;
+    }
+
+    Result = FlashUpdateProtocol->FirmwareRawEntryUpdate (
+                                    FIRMWARE_TYPE_MEM_CONF,
+                                    pVerifyImage,
+                                    &VerifyLength,
+                                    ENTRY_READ,
+                                    NULL
+                                    );
+    if (((Result & 0xFF) != FIRMWARE_RET_SUCCESS) ||
+        (VerifyLength != ExpectedLength) ||
+        (CompareMem (pVerifyImage, pImage, ExpectedLength) != 0))
+    {
+      DEBUG ((DEBUG_ERROR, "Memory configuration write read-back mismatch: 0x%x\n", Result));
       goto Done;
     }
+
+    DEBUG ((DEBUG_INFO, "Memory configuration write verified\n"));
   }
 
   DEBUG ((DEBUG_INFO, "Debug-------------------------------------------------------[%a][%d]\n", __FUNCTION__, __LINE__));
@@ -398,6 +494,10 @@ Done:
     FreePool (pImage);
   }
 
+  if (pVerifyImage != NULL) {
+    FreePool (pVerifyImage);
+  }
+
   if (pPlatformSetupVar != NULL) {
     FreePool (pPlatformSetupVar);
   }
diff --git a/Platform/Radxa/Platforms/CIX/Sky1/Drivers/PlatformConfigDxe/MemMenu/MemoryConfig.uni b/Platform/Radxa/Platforms/CIX/Sky1/Drivers/PlatformConfigDxe/MemMenu/MemoryConfig.uni
index 4ee6464a..4e4ea357 100644
--- a/Platform/Radxa/Platforms/CIX/Sky1/Drivers/PlatformConfigDxe/MemMenu/MemoryConfig.uni
+++ b/Platform/Radxa/Platforms/CIX/Sky1/Drivers/PlatformConfigDxe/MemMenu/MemoryConfig.uni
@@ -18,7 +18,7 @@ SPDX-License-Identifier: BSD-2-Clause-Patent
 #string STR_VALUE                              #language en-US "    Value"
 
 #string STR_MEM_FREQUENCY_PROMPT               #language en-US "Memory Data Rate"
-#string STR_MEM_FREQUENCY_PROMPT_HELP          #language en-US "Memory Data Rate Config"
+#string STR_MEM_FREQUENCY_PROMPT_HELP          #language en-US "Auto uses the vendor board configuration. Every explicit value requests that data rate without changing the board-qualified limit; unsupported rates may prevent the board from reaching UEFI setup."
 #string STR_DDR_1600                           #language en-US "1600MT/s"
 #string STR_DDR_2133                           #language en-US "2133MT/s"
 #string STR_DDR_2750                           #language en-US "2750MT/s"
-- 
