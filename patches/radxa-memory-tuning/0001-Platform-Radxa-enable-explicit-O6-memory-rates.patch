--- a/Platform/CIX/Sky1/Drivers/MemConfigUpdateDxe/MemConfigUpdateDxe.c
+++ b/Platform/CIX/Sky1/Drivers/MemConfigUpdateDxe/MemConfigUpdateDxe.c
@@ -12,6 +12,32 @@
 MEM_CONFIG_BLOCK_TABLE_ENTRY  *mCdcbBlockEntry = NULL;
 UINT8                         mCdcbBlockCount  = 0;
 
+#define O6_MEMORY_FREQUENCY_AUTO  0xFFFFU
+
+typedef struct {
+  UINT16    BoardMask;
+  UINT16    MaxFrequency;
+} O6_VENDOR_MEMORY_LIMIT;
+
+// Preserve the source board limits when Memory Data Rate is Auto.  An explicit
+// setup value may raise the matching configuration ceiling so the request is
+// not silently capped below the selected data rate.
+STATIC CONST O6_VENDOR_MEMORY_LIMIT  mO6VendorMemoryLimits[] = {
+  { 0xFFFF, 2750 }, // Default
+  { 0x0001, 2750 }, // 8 GB
+  { 0x0002, 2750 }, // 12 GB
+  { 0x0004, 2750 }, // 16 GB
+  { 0x0010, 2750 }, // 32 GB
+  { 0x0020, 2750 }, // 48 GB high speed
+  { 0x0040, 2750 }, // 64 GB x8
+  { 0x0080, 2400 }, // 32 GB low speed
+  { 0x0100, 2750 }, // 64 GB Rayson
+  { 0x0200, 2750 }, // 32 GB x8 high speed
+  { 0x0400, 2750 }, // 24 GB high speed
+  { 0x0800, 2400 }, // 16 GB high speed
+  { 0x1000, 3000 }, // 32 GB Hynix
+};
+
 // EFI_STATUS
 // CdcbLoadBuffer (
 //   UINT8  **buf,
@@ -89,6 +115,131 @@ GenCheckSum (
   return ~CheckSum;
 }
 
+STATIC
+BOOLEAN
+O6MemoryFrequencyIsValid (
+  IN UINT16  Frequency
+  )
+{
+  switch (Frequency) {
+    case 800:
+    case 1067:
+    case 1375:
+    case 1600:
+    case 1867:
+    case 2133:
+    case 2400:
+    case 2750:
+    case 3000:
+    case 3200:
+    case O6_MEMORY_FREQUENCY_AUTO:
+      return TRUE;
+    default:
+      return FALSE;
+  }
+}
+
+STATIC
+BOOLEAN
+O6GetVendorMemoryLimit (
+  IN  UINT16  BoardMask,
+  OUT UINT16  *MaxFrequency
+  )
+{
+  UINTN  Index;
+
+  for (Index = 0; Index < ARRAY_SIZE (mO6VendorMemoryLimits); Index++) {
+    if (mO6VendorMemoryLimits[Index].BoardMask == BoardMask) {
+      *MaxFrequency = mO6VendorMemoryLimits[Index].MaxFrequency;
+      return TRUE;
+    }
+  }
+
+  return FALSE;
+}
+
+STATIC
+EFI_STATUS
+O6UpdateMemoryLimits (
+  IN     UINT16   RequestedFrequency,
+  IN OUT UINT8    *Image,
+  IN     UINTN    ImageSize,
+  IN OUT BOOLEAN  *Update
+  )
+{
+  MEM_CONFIG_BLOCK_CONFIG  *Config;
+  UINTN                    BlockOffset;
+  BOOLEAN                  Found;
+  UINT16                   MaxFrequency;
+  UINT16                   VendorLimit;
+  UINTN                    Index;
+
+  if (!O6MemoryFrequencyIsValid (RequestedFrequency)) {
+    DEBUG ((DEBUG_ERROR, "Invalid O6 memory frequency: %u\n", RequestedFrequency));
+    return EFI_INVALID_PARAMETER;
+  }
+
+  Found = FALSE;
+  for (Index = 0; Index < mCdcbBlockCount; Index++) {
+    if (mCdcbBlockEntry[Index].Guid != MEM_CONFIG_BLOCK_CONFIG_GUID) {
+      continue;
+    }
+
+    BlockOffset = CDCB_MEM_CONFIG_HEADER_OFFSET + mCdcbBlockEntry[Index].Offset;
+    if ((BlockOffset > ImageSize) ||
+        ((ImageSize - BlockOffset) < sizeof (*Config)))
+    {
+      DEBUG ((DEBUG_ERROR, "O6 memory CONF block is outside the image\n"));
+      return EFI_COMPROMISED_DATA;
+    }
+
+    Config = (MEM_CONFIG_BLOCK_CONFIG *)(Image + BlockOffset);
+    if ((Config->Header.Signature != MEM_CONFIG_BLOCK_CONFIG_SIGNAUTE) ||
+        (Config->Header.BlockSize < sizeof (*Config)) ||
+        (Config->Header.BlockSize > (ImageSize - BlockOffset)) ||
+        !CdcbValidateChecksum ((UINT8 *)Config, Config->Header.BlockSize))
+    {
+      DEBUG ((DEBUG_ERROR, "Invalid O6 memory CONF block\n"));
+      return EFI_COMPROMISED_DATA;
+    }
+
+    if (!O6GetVendorMemoryLimit (Config->Header.BoardMask, &VendorLimit)) {
+      DEBUG ((DEBUG_WARN, "Ignore unknown O6 memory board mask: 0x%x\n", Config->Header.BoardMask));
+      continue;
+    }
+
+    MaxFrequency = VendorLimit;
+    if ((RequestedFrequency != O6_MEMORY_FREQUENCY_AUTO) &&
+        (RequestedFrequency > MaxFrequency))
+    {
+      MaxFrequency = RequestedFrequency;
+    }
+
+    if (Config->MaxFreq != MaxFrequency) {
+      DEBUG ((
+        DEBUG_INFO,
+        "Update O6 memory maximum for board mask 0x%x: %u -> %u\n",
+        Config->Header.BoardMask,
+        Config->MaxFreq,
+        MaxFrequency
+        ));
+      Config->MaxFreq                    = MaxFrequency;
+      Config->Header.BlockChecksum       = 0;
+      Config->Header.BlockChecksum       = GenCheckSum ((UINT8 *)Config, Config->Header.BlockSize);
+      *Update                            = TRUE;
+    }
+
+    Found = TRUE;
+  }
+
+  if (!Found) {
+    DEBUG ((DEBUG_ERROR, "No supported O6 memory CONF block found\n"));
+    return EFI_NOT_FOUND;
+  }
+
+  return EFI_SUCCESS;
+}
+
