+  }
+
   if (!CdcbValidateChecksum ((UINT8 *)GlobalHeader, GlobalHeader->HeaderSize)) {
     // DDR_DRV_PRINT(BASE_INFO, "Error: CDCB header checksum failed!\n");
     DEBUG ((DEBUG_ERROR, "Error: CDCB header checksum failed!\n"));
     return EFI_NOT_FOUND;
   }
 
+  ImageSize = CDCB_MEM_CONFIG_HEADER_OFFSET + GlobalHeader->TotalSize;
+
   mCdcbBlockCount = GlobalHeader->BlockCount;
+  BlockTableSize  = (UINTN)mCdcbBlockCount * sizeof (*mCdcbBlockEntry);
+  if ((CDCB_MEM_CONFIG_BLOCK_TABLE_OFFSET > ImageSize) ||
+      (BlockTableSize > (ImageSize - CDCB_MEM_CONFIG_BLOCK_TABLE_OFFSET)))
+  {
+    DEBUG ((DEBUG_ERROR, "Memory configuration block table is outside the image\n"));
+    return EFI_COMPROMISED_DATA;
+  }
+
   mCdcbBlockEntry = (MEM_CONFIG_BLOCK_TABLE_ENTRY *)(pImage + CDCB_MEM_CONFIG_BLOCK_TABLE_OFFSET);
   for (UINT8 Index = 0; Index < mCdcbBlockCount; Index++) {
     DEBUG ((DEBUG_INFO, "GUID:%X Offset:%x\n", mCdcbBlockEntry[Index].Guid, mCdcbBlockEntry[Index].Offset));
     if (mCdcbBlockEntry[Index].Guid == MEM_CONFIG_BLOCK_BIOS_SETUP_GUID) {
-      Found  = TRUE;
-      Offset = mCdcbBlockEntry[Index].Offset;
+      Found       = TRUE;
+      BlockOffset = CDCB_MEM_CONFIG_HEADER_OFFSET + mCdcbBlockEntry[Index].Offset;
       break;
     }
   }
 
   if (Found) {
-    MemConfigBiosSetup = (MEM_CONFIG_BIOS_SETUP *)(pImage + CDCB_MEM_CONFIG_HEADER_OFFSET + Offset);
-    if (MemConfigBiosSetup->Header.Signature != MEM_CONFIG_BLOCK_BIOS_SETUP_SIGNATURE) {
-      DEBUG ((DEBUG_ERROR, "Error: Incorrect BSET header signature!\n"));
-      return EFI_NOT_FOUND;
+    if ((BlockOffset > ImageSize) ||
+        ((ImageSize - BlockOffset) < sizeof (*MemConfigBiosSetup)))
+    {
+      DEBUG ((DEBUG_ERROR, "Memory BSET block is outside the image\n"));
+      return EFI_COMPROMISED_DATA;
+    }
+
+    MemConfigBiosSetup = (MEM_CONFIG_BIOS_SETUP *)(pImage + BlockOffset);
+    if ((MemConfigBiosSetup->Header.Signature != MEM_CONFIG_BLOCK_BIOS_SETUP_SIGNATURE) ||
+        (MemConfigBiosSetup->Header.BlockSize < sizeof (*MemConfigBiosSetup)) ||
+        (MemConfigBiosSetup->Header.BlockSize > (ImageSize - BlockOffset)) ||
+        !CdcbValidateChecksum ((UINT8 *)MemConfigBiosSetup, MemConfigBiosSetup->Header.BlockSize))
+    {
+      DEBUG ((DEBUG_ERROR, "Error: Invalid BSET block\n"));
+      return EFI_COMPROMISED_DATA;
+    }
+
+    Status = O6UpdateMemoryLimits (
+               pPlatformSetupData->MemFreq,
+               pImage,
+               ImageSize,
+               Update
+               );
+    if (EFI_ERROR (Status)) {
+      return Status;
     }
 
     if (pPlatformSetupData->MemFreq != MemConfigBiosSetup->MemFreq) {
@@ -291,7 +490,7 @@ GetMemConfigBiosBlockAndUpdate (
     }
   }
 
-  return EFI_SUCCESS;
+  return Found ? EFI_SUCCESS : EFI_NOT_FOUND;
 }
 
