+
+    // devices DFS
+    DVFS_ELEMENT_IDX_NPU,
+    DVFS_ELEMENT_IDX_VPU,
+    DVFS_ELEMENT_IDX_CI700,
+    DVFS_ELEMENT_IDX_MMHUB,
+
+//  DVFS_ELEMENT_IDX_SOC,      // fix at 0.75v, SOC is not treated as a perf domain
+    DVFS_ELEMENT_IDX_COUNT
+};
