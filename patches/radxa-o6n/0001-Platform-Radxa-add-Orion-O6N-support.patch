+                    for (uint32_t k = 0; k < config[i].rpm_table_items[j]; k++) {
+                        printf("\t%d: %4d   %3d   %3d\n", k, (uint32_t)config[i].rpm_table[j][k].rpm, (int32_t)config[i].rpm_table[j][k].up_temp, (int32_t)config[i].rpm_table[j][k].down_temp);
+                    }
