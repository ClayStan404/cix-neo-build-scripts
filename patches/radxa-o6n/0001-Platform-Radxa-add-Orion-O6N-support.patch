@@ -0,0 +1,78 @@
+/** @file
+ *
+ *  Copyright 2024 Radxa Computer (Shenzhen) Co., Ltd. All Rights Reserved.
+ *  Copyright 2023 Cix Technology (Shanghai) Co., Ltd. All Rights Reserved.
+ *  Copyright (c) 2017, Linaro, Ltd. All rights reserved.<BR>
